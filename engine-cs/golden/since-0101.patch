+export function hordeClock(m: MissionState, turn: number): number {
+  if (m.kind === 'elimination') return m.noise ?? 0;
+  return (turn + (m.night ? NIGHT.hordeHead : 0)) * HORDE.perTurn + (m.noise ?? 0);
