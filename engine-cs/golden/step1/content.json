cription":"Dispara al primer enemigo que se mueva a la vista.","target":"self","ap":1,"endsTurn":true},"stone":{"id":"stone","name":"Piedra","description":"Lanza una piedra: suena donde cae y los zombis van a mirar. Si le da a alguien, 1 de daño.","target":"tile","ap":1,"endsTurn":false,"range":10,"noise":8},"overwatchMelee":{"id":"overwatchMelee","name":"Vigilancia cuerpo a cuerpo","description":"Golpea con la hoja al primer enemigo que se le ponga al lado.","target":"self","ap":1,"endsTurn":true},"hunker":{"id":"hunker","name":"Cubrirse","description":"+30 de defensa y +50 de esquiva hasta tu próximo turno.","target":"self","ap":1,"endsTurn":true},"reload":{"id":"reload","name":"Recargar","description":"Mete un cargador lleno y gasta uno de repuesto: primero en el arma principal y, si está llena, en la pistola. Los de repuesto los hace el Taller; registrando aparecen más.","target":"self","ap":1,"endsTurn":false},"grenade":{"id":"grenade","name":"Granada","description":"Lanza una granada: daña a todos en el área, destruye cobertura y abre boquetes en las paredes. Arriba hunde el suelo donde cae, y quien esté encima cae.","target":"tile","ap":1,"endsTurn":true,"charge":"grenade","range":10,"radius":2.5,"explosive":"fragGrenade"},"launch":{"id":"launch","name":"Lanzagranadas","description":"Dispara una granada más lejos y con más radio. También abre boquetes en las paredes y, arriba, hunde el suelo donde cae.","target":"tile","ap":1,"endsTurn":true,"charge":"grenade","range":14,"radius":3.5,"explosive":"fragGrenade"},"missiles":{"id":"missiles","name":"Granada del chaleco","description":"Le estalla una granada que aún cuelga del chaleco. También abre boquetes en las paredes y, arriba, hunde el suelo.","target":"tile","ap":1,"endsTurn":true,"charge":"missiles","range":15,"radius":2.5,"explosive":"microMissiles"},"evac":{"id":"evac","name":"Evacuar","description":"Desde La Lata, pide salir. Si el otro jugador acepta, salen los que estén dentro y los de fuera se pierden. En la Limpieza es una retirada: la misión se pierde.","target":"self","ap":0,"endsTurn":false},"hack":{"id":"hack","name":"Arreglar","description":"Arregla el equipo (una radio, un repetidor…) desde una casilla de al lado. Si falla, salta la alarma: se oye lejos y atrae a los muertos por los bordes.","target":"self","ap":1,"endsTurn":true,"noise":2},"search":{"id":"search","name":"Abrir la caja","description":"Abre una caja marcada que tengas al lado. Da siempre lo suyo: un arma, una o dos medicinas, dos cargadores o de 3 a 5 raciones. Hace un poco de ruido.","target":"tile","ap":1,"endsTurn":false,"range":1.5,"noise":2},"searchRoom":{"id":"searchRoom","name":"Registrar la habitación","description":"Registra la habitación en la que estás. Sale lo que haya según el sitio: suministros, comida, piezas, medicinas, algún cargador y, a veces, un arma. Cada habitación se registra una vez, para toda la escuadra. Hace un poco de ruido.","target":"self","ap":1,"endsTurn":false,"noise":2},"openDoor":{"id":"openDoor","name":"Abrir la puerta","description":"Abre una puerta cerrada que tengas al lado.","target":"tile","ap":0,"endsTurn":false,"range":1.5,"noise":1},"closeDoor":{"id":"closeDoor","name":"Cerrar la puerta","description":"Cierra una puerta abierta que tengas al lado, si no hay nadie en ella.","target":"tile","ap":0,"endsTurn":false,"range":1.5,"noise":1},"runAndGun":{"id":"runAndGun","name":"Correr y disparar","description":"Una acción más este turno.","target":"self","ap":0,"endsTurn":false,"cooldown":4},"rapidFire":{"id":"rapidFire","name":"Ráfaga","description":"Dos disparos seguidos, cada uno con −15 de puntería. Gasta dos balas.","target":"enemy","ap":1,"endsTurn":false,"cooldown":3,"weapon":"primary","aim":-15,"ammo":2},"suppression":{"id":"suppression","name":"Supresión","description":"Inmoviliza al objetivo: −50 de puntería hasta tu próximo turno, y si se mueve, le disparas. Gasta dos balas.","target":"enemy","ap":1,"endsTurn":true,"ammo":2},"chainShot":{"i