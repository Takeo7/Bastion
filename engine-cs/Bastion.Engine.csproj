<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine as a plain .NET library, for `dotnet test` without the editor; Unity compiles the same files from package/ (docs/UNITY.md §2). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Bastion.Engine</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="package/Runtime/**/*.cs" Exclude="package/Runtime/Net/**" />
    <!-- Work in progress (README: engine-cs/wip/): built and tested here, out of Unity's sight until it compiles. -->
    <Compile Include="wip/**/*.cs" Exclude="wip/Net/**" />
  </ItemGroup>
</Project>
