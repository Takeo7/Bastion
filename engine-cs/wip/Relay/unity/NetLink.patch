+        /// <summary>Through the relay with `code`: its no kept (refusedBy), for the text if joining fails, or to know the game closed.</summary>
+        private async Task<IConnection> DialCode(RelayAddress relay, string code, CancellationToken cancel)
+        {
+            try
+            {
+                var c = await RelayDial.JoinAsync(relay, code, cancel).ConfigureAwait(false);
+                refusedBy = null;
+                return c;
+            }
+            catch (RelayRefusedException e)
+            {
+                refusedBy = e.Reason;
+                throw;
+            }
+            catch (Exception)
+            {
+                refusedBy = "";
+                throw;
+            }
+        }
+
+        /// <summary>Why joining by a code failed, said for the player (the relay's no, RelayRefusal).</summary>
+        private string CodeFailure(string code, string? why)
+        {
+            switch (why)
+            {
+                case RelayRefusal.Unknown:
+                    return $"No hay ninguna partida abierta con el código {code}. El código cambia cada vez que se abre la partida.";
+                case RelayRefusal.Away:
+                case RelayRefusal.Timeout:
+                    return "Quien aloja la partida no contesta ahora. Espera un momento y vuelve a intentarlo.";
+                case RelayRefusal.Limit:
+                    return "Demasiados intentos con códigos que no valen. Espera media hora y vuelve a intentarlo.";
+                case RelayRefusal.Full:
+                    return "El servidor de Bastión está lleno ahora mismo. Vuelve a intentarlo dentro de un rato.";
+                case RelayRefusal.Version:
+                    return "El servidor de Bastión pide una versión más nueva del juego.";
+                default:
+                    return "El servidor de Bastión no responde. Por la red local o por Tailscale se puede jugar igual.";
+            }
+        }
