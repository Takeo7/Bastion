/*
   Proposal «Mando» (Military Combat HUD as its TeamShooter and Survival demos): steel-blue plates with screws and cut
   corners, red for what is urgent and orange for objectives; the log as the demos' feed on the top left, the squad as
   their numbered fireteam, the bar between two hexagons (health and actions) and the weapon over «Terminar turno»
   (Temas.Mando places those parts).
*/

.hud {
    --t-text: #ffffff;
    --t-muted: #93a7b8;
    --t-accent: #f7a20f;
    --t-accent-soft: rgba(247, 162, 15, 0.05);
    --t-primary: #be2f2f;
    --t-primary-hover: #d43a3a;
    --t-primary-ink: #ffffff;
    --t-panel: rgba(9, 21, 31, 0.86);
    --t-panel-hi: rgba(24, 50, 72, 0.9);
    --t-tag: rgba(7, 11, 14, 0.82);
    --m-steel: rgb(24, 50, 72);
    --m-steel-hi: rgb(32, 66, 94);
}

.hud .panel {
    rotate: 0;
    border-width: 0;
}

/* ------------------------------------------------------------------ the feed (the log), top left */

.hud .tema-feed {
    position: absolute;
    left: 14px;
    top: 12px;
    width: 300px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.log__line {
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/HUD/SPR_HUD_MilitaryCombat_Background_DogEar_01.png?fileID=1537655665&guid=657096734ab6ba74a9d219de078b972d&type=3#SPR_HUD_MilitaryCombat_Background_DogEar_01");
    -unity-background-image-tint-color: rgba(7, 11, 14, 0.82);
    -unity-slice-scale: 0.12px;
    border-left-width: 3px;
    border-left-color: #be2f2f;
    padding: 3px 12px 4px 8px;
    margin-bottom: 3px;
}

/* ------------------------------------------------------------------ the fireteam (the squad), left */

.hud .squad {
    top: 128px;
    width: 226px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.squad-card {
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/HUD/SPR_HUD_MilitaryCombat_Background_DogEar_02.png?fileID=1537655665&guid=88ecd46cc17cbcb4a989ed841fd08e23&type=3#SPR_HUD_MilitaryCombat_Background_DogEar_02");
    -unity-background-image-tint-color: rgba(11, 17, 21, 0.8);
    -unity-slice-scale: 0.12px;
    background-color: rgba(0, 0, 0, 0);
    margin-bottom: 4px;
    padding: 0 12px 0 0;
    align-items: stretch;
}

.squad-card--selected {
    -unity-background-image-tint-color: rgba(28, 61, 86, 0.95);
}

.squad-card__accent {
    width: 26px;
    margin-right: 8px;
    justify-content: center;
}

.tema-number {
    -unity-text-align: middle-center;
    font-size: 15px;
    color: #ffffff;
}

.squad-card__body {
    padding: 3px 0 4px;
}

.pip--on {
    background-color: #ffffff;
}

.pips--ap .pip--on {
    background-color: #f7a20f;
}

/* ------------------------------------------------------------------ the soldier, bottom left: a railed plate */

.hud .unit-panel {
    bottom: 14px;
    padding: 20px 16px 14px;
    background-color: rgba(9, 21, 31, 0.9);
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/MilitaryCombat/SPR_MilitaryCombat_Frame_Medium_12.png?fileID=1537655665&guid=152c1b950806afd4884687522174da94&type=3#SPR_MilitaryCombat_Frame_Medium_12");
    -unity-slice-scale: 0.09px;
    border-radius: 6px;
}

.stat-icon {
    -unity-background-image-tint-color: #8fd2f2;
}

/* ------------------------------------------------------------------ the bar: keys in steel, red numbers under them */

.hud .abilities {
    left: 50%;
    right: auto;
    translate: -50% 0;
    bottom: 42px;
    padding: 9px 10px;
    background-color: rgba(9, 21, 31, 0.92);
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/MilitaryCombat/SPR_MilitaryCombat_Box_Medium_04.png?fileID=1537655665&guid=1fa9bd341a924174d95184e4e0ee1af2&type=3#SPR_MilitaryCombat_Box_Medium_04");
    -unity-slice-scale: 0.07px;
    border-radius: 4px;
}

.hud .ability {
    width: 52px;
    height: 52px;
    margin: 0 3px;
    background-color: rgb(24, 50, 72);
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/MilitaryCombat/SPR_MilitaryCombat_Frame_Small_03.png?fileID=1537655665&guid=a60a8c615a7747d4da15bbaddc840ba0&type=3#SPR_MilitaryCombat_Frame_Small_03");
    -unity-slice-scale: 0.12px;
    border-width: 0;
    border-radius: 3px;
}

.hud .ability--active {
    -unity-background-image-tint-color: #f7a20f;
    background-color: rgb(4, 98, 173);
    border-width: 0;
}

.ability__icon {
    -unity-background-image-tint-color: #ffffff;
}

.tema-key {
    position: absolute;
    top: 68px;
    left: 50%;
    translate: -50% 0;
    width: 22px;
    height: 20px;
    background-color: #be2f2f;
    border-radius: 2px;
    color: #ffffff;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.tema-rail {
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/MilitaryCombat/SPR_MilitaryCombat_Bar_Large_01.png?fileID=1537655665&guid=9c35073178f858d44884f8cd701a599a&type=3#SPR_MilitaryCombat_Bar_Large_01");
    -unity-slice-scale: 0.16px;
}

.tema-rail__well {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 9px;
    bottom: 7px;
    background-color: rgba(5, 10, 21, 0.9);
}

.tema-rail__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: #be2f2f;
}

.tema-rail__text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: -2px;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: #ffffff;
}

.tema-hex__text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: #ffffff;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
}

/* ------------------------------------------------------------------ the weapon, over «Terminar turno» */

.tema-weapon {
    -unity-slice-scale: 0.1px;
    background-color: rgba(9, 21, 31, 0.92);
    border-radius: 4px;
}

.tema-weapon__icon {
    position: absolute;
    left: 16px;
    top: 14px;
    width: 104px;
    height: 46px;
    -unity-background-scale-mode: scale-to-fit;
}

.tema-weapon__figures {
    position: absolute;
    right: 16px;
    top: 8px;
    flex-direction: row;
    align-items: flex-end;
}

.tema-weapon__big {
    font-size: 36px;
    color: #ffffff;
}

.tema-weapon__small {
    margin-left: 4px;
    margin-bottom: 7px;
    font-size: 17px;
    color: #93a7b8;
}

.tema-weapon__name {
    position: absolute;
    left: 16px;
    bottom: 8px;
    font-size: 12px;
    color: #93a7b8;
}

.tema-weapon__key {
    position: absolute;
    left: -30px;
    top: 26px;
    width: 22px;
    height: 22px;
    background-color: rgb(24, 50, 72);
    border-radius: 2px;
    color: #ffffff;
    font-size: 13px;
    -unity-text-align: middle-center;
}

/* ------------------------------------------------------------------ the shot: a railed plate with screws */

.hud .shot-panel {
    width: 270px;
    padding: 26px 22px 20px;
    background-color: rgba(9, 21, 31, 0.93);
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/MilitaryCombat/SPR_MilitaryCombat_Frame_Medium_17.png?fileID=1537655665&guid=b5c5a9be860c1ff4db5a1b9257bb341e&type=3#SPR_MilitaryCombat_Frame_Medium_17");
    -unity-slice-scale: 0.1px;
    border-radius: 6px;
}

.shot-title {
    color: #ffffff;
    border-bottom-width: 2px;
    border-bottom-color: #be2f2f;
    padding-bottom: 3px;
}

.fire {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/HUD/SPR_HUD_MilitaryCombat_Background_DogEar_01.png?fileID=1537655665&guid=657096734ab6ba74a9d219de078b972d&type=3#SPR_HUD_MilitaryCombat_Background_DogEar_01");
    -unity-background-image-tint-color: #be2f2f;
    -unity-slice-scale: 0.14px;
    color: #ffffff;
    border-width: 0;
}

.cancel,
.cycle {
    background-color: rgb(24, 50, 72);
    border-width: 0;
}

/* ------------------------------------------------------------------ the top and the right */

.floor-ind,
.player,
.tag,
.menu-button,
.turn__in-play {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/HUD/SPR_HUD_MilitaryCombat_Background_DogEar_02.png?fileID=1537655665&guid=88ecd46cc17cbcb4a989ed841fd08e23&type=3#SPR_HUD_MilitaryCombat_Background_DogEar_02");
    -unity-background-image-tint-color: rgba(9, 21, 31, 0.88);
    -unity-slice-scale: 0.1px;
    border-width: 0;
}

.tag--conceal,
.conceal--on {
    -unity-background-image-tint-color: #be2f2f;
    color: #ffffff;
}

/* The objective: an orange gem in its socket (Temas), on a fading strip. */
.hud .goal-dock {
    padding: 6px 12px 8px 44px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/HUD/SPR_HUD_MilitaryCombat_Gradient_Horizontal_01.png?fileID=21300000&guid=5fe40f55b3a2b2b4aaf64326c03c1d5e&type=3#SPR_HUD_MilitaryCombat_Gradient_Horizontal_01");
    -unity-background-image-tint-color: rgba(9, 21, 31, 0.92);
}

.mission-kind {
    color: #f7a20f;
    font-size: 22px;
}

.hud .side .log {
    background-color: rgba(0, 0, 0, 0);
}

/* «Terminar turno»: the demos' orange «Next». */
.end-turn {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/HUD/SPR_HUD_MilitaryCombat_Background_DogEar_01.png?fileID=1537655665&guid=657096734ab6ba74a9d219de078b972d&type=3#SPR_HUD_MilitaryCombat_Background_DogEar_01");
    -unity-background-image-tint-color: #f7a20f;
    -unity-slice-scale: 0.16px;
    border-width: 0;
}

.end-turn__label,
.end-turn__detail {
    color: #09151f;
}

.turn-btn {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Synty/InterfaceMilitaryCombatHUD/Sprites/HUD/SPR_HUD_MilitaryCombat_Background_DogEar_02.png?fileID=1537655665&guid=88ecd46cc17cbcb4a989ed841fd08e23&type=3#SPR_HUD_MilitaryCombat_Background_DogEar_02");
    -unity-background-image-tint-color: rgba(9, 21, 31, 0.88);
    -unity-slice-scale: 0.1px;
    border-width: 0;
}
