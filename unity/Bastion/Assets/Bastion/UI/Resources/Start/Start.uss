/*
   The start screen (Arturo's notes of 14/11; 0.12.24), over Arte's scene: clear itself, the main menu's dark band
   drawn by StartScreen (Fade) from the left, fading on a slant into the scene; BASTIÓN and the keys on it. «Partida
   multijugador»: no band, two cards in the middle.
*/

.start {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.start__fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* The main menu's column: the entries to the left, under the title's height (cuadro 149). */
/* (The first entry's middle at 22.5 % of the height: CORRECCIONES-2; each entry 6.5 % high, StartScreen.SizeEntry.) */
.start__side {
    position: absolute;
    left: 7%;
    top: 19.25%;
    bottom: 8%;
    align-items: flex-start;
}

/*
   The title (cuadro 149, Arturo's picture): in the middle at the top, big, bone. Arte's worn picture of it when it is there
   (start__title--art): 29 % of the width, its top at 5 % of the height. The boot's sheet puts it the same (LoadWindow).
*/
.start__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 5%;
    margin: 0;
    font-size: 104px;
    letter-spacing: 8px;
    -unity-text-align: upper-center;
    color: #e6dccb;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.45);
}

/* (Placed by StartScreen.PlaceTitle: 29 % of the width, its letters from 5.8 % of the height.) */
.start__title--art {
    -unity-background-scale-mode: scale-to-fit;
}

/* The dark veil on a slant over the top left (cuadro 150), Arturo's texture since 28/11: one picture, stretched (StartLook.Veil). */
.start__veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.start__edges {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/*
   An entry (cuadro 149): no plate, its words as written, bone and worn (start__wear: the scratches over them); the chosen
   one (start__entry--chosen) on Arturo's dark red brush stroke, wider than its words, its words bone as the others' (28/11).
   Its words start at the column's edge; the stroke a little before them.
*/
.start__entry {
    margin: 0 0 0 -22px;
    padding: 0 34px 0 22px;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    align-items: flex-start;
}

.start__entry:hover,
.start__entry:active,
.start__entry:focus {
    background-color: rgba(0, 0, 0, 0);
}

.start__entry:disabled {
    opacity: 0.5;
}

/* A form's key as an entry (cuadro 151): its stroke round its words (StartLook), in a row. */
.start__entry.start__entry--short {
    margin: 0 4px 0 0;
    padding: 6px 44px 6px 16px;
}

.start__entry--short > .start__entry-text {
    font-size: 24px;
}

/* The family's Regular (cuadro 150: the picture's words are thin, not bold; its download, Arturo's yes). */
/* (28/11, his final picture: its capitals 3.3 % of the height, 36px on the 800 of the panel; a duller bone, measured there.) */
.start__entry-text {
    -unity-font-definition: url("../../Fonts/Oswald-Regular SDF.asset");
    margin: 0;
    padding: 0;
    font-size: 36px;
    letter-spacing: 0.5px;
    color: #cbbfae;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
}

.start__brush {
    position: absolute;
    left: 0;
    top: 1px;
    right: 0;
    bottom: 1px;
    display: none;
    background-color: #5a2414;
}

.start__brush--art {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.start__entry--chosen > .start__brush {
    display: flex;
}

/* (Placed and sized over the words by StartLook.Entries.Size.) */
.start__wear {
    position: absolute;
    background-repeat: repeat repeat;
}

.start__menu {
    align-items: flex-start;
}

/*
   A key (the maqueta's): straight ends, dark grey worn (the steel's grain faint over it), its words white, as wide as
   they are; pointed at, lighter and a step to the right.
*/
.start__key {
    margin: 0 0 12px 0;
    padding: 6px 16px 7px;
    font-size: 24px;
    letter-spacing: 1.5px;
    -unity-text-align: middle-left;
    color: #eceee8;
    background-color: rgba(34, 36, 38, 0.94);
    background-image: url("../../Textures/steel-plate.png");
    background-repeat: repeat repeat;
    background-size: 256px 256px;
    -unity-background-image-tint-color: rgba(70, 72, 74, 0.9);
    border-width: 0 0 2px 0;
    border-bottom-color: rgba(0, 0, 0, 0.55);
    border-radius: 0;
    transition-property: translate, background-color, color;
    transition-duration: 0.1s, 0.1s, 0.1s;
}

.start__key:hover {
    translate: 4px 0;
    color: #ffffff;
    background-color: rgba(58, 61, 63, 0.96);
    -unity-background-image-tint-color: rgba(96, 99, 101, 0.9);
}

.start__key:active {
    scale: 1 1;
}

.start__key:disabled {
    opacity: 0.5;
}

/* The campaign from before the expeditions, set aside: where «Continuar partida» would be (Red, 16/11). */
.start__old {
    max-width: 420px;
    margin: 0 0 14px 0;
    font-size: 15px;
    white-space: normal;
    color: #c4c9c0;
}

/* «Volver» of «Partida multijugador»: where the keys were, at the foot. */
.start__back {
    position: absolute;
    left: 7%;
    bottom: 8%;
    margin: 0;
}

/* «Partida multijugador»: the two cards side by side in the middle. */
.start__center {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.start__cards {
    flex-direction: row;
}

/*
   A card (the maqueta's): straight, dark, its edge worn light grey, a red icon on its face and its words in a band at
   its foot. Both the same size.
*/
.start__card {
    width: 300px;
    height: 230px;
    margin: 0 10px;
    padding: 0;
    align-items: stretch;
    background-color: rgba(10, 11, 12, 0.9);
    background-image: url("../../Textures/steel-plate.png");
    background-repeat: repeat repeat;
    background-size: 256px 256px;
    -unity-background-image-tint-color: rgba(34, 36, 38, 0.9);
    border-width: 2px;
    border-color: rgba(196, 198, 194, 0.55);
    border-radius: 0;
    transition-property: translate, border-color, background-color;
    transition-duration: 0.1s, 0.1s, 0.1s;
}

.start__card:hover {
    translate: 0 -3px;
    border-color: rgba(236, 238, 232, 0.85);
    background-color: rgba(22, 24, 25, 0.92);
}

.start__card:active {
    scale: 1 1;
}

.start__card:disabled {
    opacity: 0.5;
}

.start__card-face {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

/* Arte's red icons (the flag, the two soldiers): Resources/Start/icono-alojar and icono-unirse, put by StartScreen. */
.start__card-icon {
    width: 132px;
    height: 132px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(196, 56, 40);
}

.start__card-label {
    padding: 10px 8px 12px;
    font-size: 21px;
    letter-spacing: 1.2px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: #eceee8;
    border-top-width: 2px;
    border-top-color: rgba(196, 198, 194, 0.55);
}

/* What is asked (the name; a game by its address and key): a dark plate where the keys were, or in the middle. */
.start__form {
    width: 380px;
    padding: 14px 16px 4px;
    background-color: rgba(10, 11, 12, 0.92);
    border-width: 1px;
    border-color: rgba(196, 198, 194, 0.3);
}

.start__field {
    margin-bottom: 12px;
}

.start__label {
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--t-muted);
    margin-bottom: 3px;
}

.start__input {
    margin: 0;
}

.start__input > .unity-base-field__input {
    padding: 4px 8px;
    font-size: 16px;
    color: var(--t-text);
    background-color: var(--m-well);
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 0;
}

/* An example, a hint and not a value: grey. */
.start__input .unity-base-text-field__input--placeholder,
.start__input .unity-text-element--placeholder {
    color: var(--t-muted);
}

.start__row {
    flex-direction: row;
}

.start__form .start__key {
    margin-right: 10px;
    font-size: 20px;
}

/* What it does, lit (the form's first key). */
.start__key--go {
    color: #15181a;
    background-color: rgba(236, 235, 230, 0.96);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.25);
}

.start__key--go:hover {
    color: #15181a;
    background-color: #ffffff;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.25);
}

/* What is under way or what went wrong: a line at the foot, in the middle, on a dark plate while it says something. */
.start__status {
    position: absolute;
    left: 25%;
    right: 25%;
    bottom: 8%;
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.start__status--on {
    padding: 6px 12px;
    background-color: rgba(10, 11, 12, 0.88);
}

.start__status--bad {
    color: var(--t-danger);
}

.start__version {
    position: absolute;
    right: 16px;
    bottom: 10px;
    font-size: 10px;
    color: var(--t-muted);
}

/* Under «Continuar partida», the saved game's chapter and level (cuadro 125). */
/* (Clear of the brush stroke over «Continuar partida», 5.4 % of the screen high.) */
/* On «Continuar partida»'s line, past its brush stroke (StartScreen.SizeEntry). */
.start__saved {
    position: absolute;
    margin: 0;
    font-size: 15px;
    color: #cfc6b4;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.6);
}

/* The game's level, asked with the name for a new game and to host one (N9; cuadro 125, Arturo 23/11): in the middle,
   the four side by side as cards, each its name and what it changes, the one picked lit as the go key; Supervivencia's name
   in the danger red. Their line whole: cards as tall as the longest needs. */
.start__form--levels {
    width: 92%;
    max-width: 1000px;
    padding: 16px 18px 6px;
}

.start__form--levels .start__field {
    width: 300px;
}

