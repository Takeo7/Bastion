/* The arrows at the screen's edge (EdgeMarks.cs; styles.css .edge-mark): a small steel plate, the arrow and the words in
   the mark's colour: the objective in the accent, the evacuation in green, the partner's moment in the stamp's red. */
.edge-marks {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.edge-mark {
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
    padding: 3px 9px 3px 5px;
}

.edge-mark:hover {
    -unity-background-image-tint-color: rgba(40, 43, 46, 0.95);
}

/* On the arrow and the words themselves: Mixta's Label sets its own colour. */
.edge-mark .edge-mark__arrow,
.edge-mark .edge-mark__label {
    color: var(--t-accent);
}

.edge-mark--evac .edge-mark__arrow,
.edge-mark--evac .edge-mark__label {
    color: var(--t-good);
}

.edge-mark--alert {
    border-width: 2px;
    border-color: var(--t-danger);
    transition-property: opacity;
    transition-duration: 0.7s;
    transition-timing-function: ease-in-out;
}

/* Half of its beat (EdgeMarks.cs). */
.edge-mark--dim {
    opacity: 0.65;
}

.edge-mark--alert .edge-mark__arrow,
.edge-mark--alert .edge-mark__label {
    color: var(--t-danger);
}

/* A soldier pointed at from the list and off the screen (Arturo, 31/10 #11): its name in the lit ring's light. */
.edge-mark--soldier {
    border-width: 2px;
    border-color: #ffffff;
}

.edge-mark--soldier .edge-mark__arrow,
.edge-mark--soldier .edge-mark__label {
    color: #ffffff;
}

/* The web's arrow, 20 px, 4 px from the words. */
.edge-mark__arrow {
    width: 20px;
    height: 20px;
    margin-right: 4px;
}

.edge-mark__label {
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* ============================================================ the goal */

/* Where the mission's goal lies (UI-COMBATE UI-06; GoalArrow.cs): the map's ring bottom right, its foot level with the
   squad's and the keys', and the white reticle arrow in it, turned from C# (Ana, 7/11 #4: Synty's ring and arrow). */
.goal-arrow {
    position: absolute;
    right: 12px;
    bottom: var(--edge);
    width: 76px;
    height: 76px;
}

/* The ring of the goal's arrow and of the enemies' sight: Synty INTERFACE Apocalypse HUD's map circle, black as the torn
   plates (Mixta.uss .panel). */
.map-ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Synty/InterfaceApocalypseHUD/Sprites/HUD/SPR_HUD_Apocalypse_Map_Circle_Large_02.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.8);
}

/* Synty INTERFACE Dark Fantasy HUD's reticle arrow, white, pointing up before C# turns it. */
.goal-arrow__arrow {
    position: absolute;
    left: 19px;
    top: 19px;
    right: 19px;
    bottom: 19px;
    background-image: url("/Assets/Synty/InterfaceDarkFantasyHUD/Sprites/Reticles/SPR_HUD_DarkFantasy_Reticle_Arrow_Small_08_Variant_02.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

/* The enemies' sight (SightButton; Arturo, 5/11 #6): left of the goal's arrow, a smaller ring as its with an eye, grey
   off and white on; no legend over it (Ana, 7/11 #10). */
.sight {
    position: absolute;
    right: 96px;
    bottom: var(--edge);
    width: 0;
    height: 0;
    overflow: visible;
}

.sight__button {
    position: absolute;
    right: 0;
    bottom: 12px;
    width: 52px;
    height: 52px;
}

.sight__eye {
    position: absolute;
    left: 13px;
    top: 13px;
    right: 13px;
    bottom: 13px;
    color: #8f999f;
}

.sight__button:hover .sight__eye {
    color: #c9d4dc;
}

.sight__button--on .sight__eye {
    color: #ffffff;
}

.sight__button--on:hover .sight__eye {
    color: #ffffff;
}
