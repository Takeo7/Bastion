/* The arrows at the screen's edge (EdgeMarks.cs; styles.css .edge-mark): a small steel plate, the arrow and the words in
   the mark's colour: the objective in the accent, the evacuation in green, the partner's moment in the stamp's red. */
.edge-marks {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.edge-mark {
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
    padding: 3px 9px 3px 5px;
}

.edge-mark:hover {
    background-color: var(--t-panel-hover);
}

/* On the arrow and the words themselves: Mixta's Label sets its own colour. */
.edge-mark .edge-mark__arrow,
.edge-mark .edge-mark__label {
    color: var(--t-accent);
}

.edge-mark--evac .edge-mark__arrow,
.edge-mark--evac .edge-mark__label {
    color: var(--t-good);
}

.edge-mark--alert {
    border-width: 2px;
    border-color: var(--t-danger);
    transition-property: opacity;
    transition-duration: 0.7s;
    transition-timing-function: ease-in-out;
}

/* Half of its beat (EdgeMarks.cs). */
.edge-mark--dim {
    opacity: 0.65;
}

.edge-mark--alert .edge-mark__arrow,
.edge-mark--alert .edge-mark__label {
    color: var(--t-danger);
}

/* A soldier pointed at from the list and off the screen (Arturo, 31/10 #11): its name in the lit ring's light. */
.edge-mark--soldier {
    border-width: 2px;
    border-color: #ffe27a;
}

.edge-mark--soldier .edge-mark__arrow,
.edge-mark--soldier .edge-mark__label {
    color: #ffe27a;
}

/* The web's arrow, 20 px, 4 px from the words. */
.edge-mark__arrow {
    width: 20px;
    height: 20px;
    margin-right: 4px;
}

.edge-mark__label {
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* ============================================================ the goal */

/* Where the mission's goal lies (UI-COMBATE UI-06; GoalArrow.cs): a ring of dark steel bottom right, its foot level with
   the squad's and the keys', and the yellow arrow in it, turned from C#. */
.goal-arrow {
    position: absolute;
    right: 12px;
    bottom: var(--edge);
    width: 76px;
    height: 76px;
}

.goal-arrow__ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.goal-arrow__arrow {
    position: absolute;
    left: 12px;
    top: 12px;
    right: 12px;
    bottom: 12px;
    color: var(--t-accent);
}

/* The enemies' sight (SightButton; Arturo, 5/11 #6, #9): left of the goal's arrow, a smaller ring of its steel with an
   eye, grey off and in sight's red on; over both, the legend of the red on the ground while it shows. */
.sight {
    position: absolute;
    right: 96px;
    bottom: var(--edge);
    width: 0;
    height: 0;
    overflow: visible;
}

.sight__button {
    position: absolute;
    right: 0;
    bottom: 12px;
    width: 52px;
    height: 52px;
}

.sight__eye {
    position: absolute;
    left: 13px;
    top: 13px;
    right: 13px;
    bottom: 13px;
    color: #8f999f;
}

.sight__button:hover .sight__eye {
    color: #c9d4dc;
}

.sight__button--on .sight__eye {
    color: #f0503c;
}

.sight__button--on:hover .sight__eye {
    color: #ff7a66;
}

.sight__legend {
    position: absolute;
    right: -84px;
    bottom: 86px;
    width: 236px;
    padding: 5px 8px;
    border-radius: 2px;
    background-color: rgba(14, 16, 17, 0.82);
}

.sight__row {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
}

/* As the ground's: the faint wash with its line, and the stronger one where it would notice (AimOverlay.ShowVision). */
.sight__swatch {
    flex-shrink: 0;
    width: 14px;
    height: 10px;
    margin-right: 6px;
    border-width: 1px;
    border-color: rgba(240, 80, 60, 0.8);
}

.sight__swatch--seen {
    background-color: rgba(240, 80, 60, 0.12);
}

.sight__swatch--noticed {
    background-color: rgba(240, 80, 60, 0.3);
}

.sight__text {
    flex-shrink: 1;
    font-size: 12px;
    white-space: normal;
}
