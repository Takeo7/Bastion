/* The arrows at the screen's edge (EdgeMarks.cs; styles.css .edge-mark): a small steel plate, the arrow and the words in
   the mark's colour: the objective in the accent, the evacuation in green, the partner's moment in the stamp's red. */
.edge-marks {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.edge-mark {
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
    padding: 3px 9px 3px 5px;
}

.edge-mark:hover {
    background-color: var(--t-panel-hover);
}

/* On the arrow and the words themselves: Mixta's Label sets its own colour. */
.edge-mark .edge-mark__arrow,
.edge-mark .edge-mark__label {
    color: var(--t-accent);
}

.edge-mark--evac .edge-mark__arrow,
.edge-mark--evac .edge-mark__label {
    color: var(--t-good);
}

.edge-mark--alert {
    border-width: 2px;
    border-color: var(--t-danger);
    transition-property: opacity;
    transition-duration: 0.7s;
    transition-timing-function: ease-in-out;
}

/* Half of its beat (EdgeMarks.cs). */
.edge-mark--dim {
    opacity: 0.65;
}

.edge-mark--alert .edge-mark__arrow,
.edge-mark--alert .edge-mark__label {
    color: var(--t-danger);
}

/* The web's arrow, 20 px, 4 px from the words. */
.edge-mark__arrow {
    width: 20px;
    height: 20px;
    margin-right: 4px;
}

.edge-mark__label {
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
}
