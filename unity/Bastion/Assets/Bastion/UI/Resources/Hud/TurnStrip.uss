/* The strip at the top (hud.ts setTurn, setPlayers): the soldier in play and the night, then the players (no turn tab nor
   floors: UI-COMBATE UI-03, UI-10). */

.turn {
    flex-direction: row;
    align-items: center;
}

.turn__in-play {
    margin-left: 6px;
    padding: 2px 8px;
    font-size: 11px;
    color: var(--t-accent);
    background-color: var(--t-tag);
}

/* The night: a stamp at the top, its rules in its help. */
.conceal {
    margin-left: 6px;
    padding: 2px 8px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    background-color: var(--t-tag);
    border-width: 1px;
}

.conceal--night {
    color: #9fb8ff;
    border-color: rgba(159, 184, 255, 0.5);
}

.players {
    flex-direction: row;
    margin-left: 10px;
}

.player {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    padding: 2px 6px;
    background-color: var(--t-tag);
    border-bottom-width: 2px;
    border-bottom-color: transparent;
}

/* Who holds the command: underlined in their colour (set from C#). */
.player--command {
    border-bottom-color: var(--t-accent);
}

.player--offline {
    opacity: 0.5;
}

.player__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 5px;
}

.player__name {
    font-size: 12px;
    -unity-font-style: bold;
}

.player__status {
    margin-left: 5px;
    font-size: 11px;
    color: var(--t-muted);
}

/* «MANDO» beside the holder's name, in their colour (Arturo, 7/11: whose turn it is, plainly). */
.player__command {
    margin-left: 5px;
    font-size: 11px;
    letter-spacing: 1px;
}

.player--ready .player__status {
    color: var(--t-good);
}

/* With the finger, «Ceder» by the partner (TurnStrip; only with the finger): a key of the bar's steel, a finger tall. */
.player__pass {
    height: 44px;
    margin: 0 0 0 8px;
    padding: 0 12px;
    border-width: 0;
    font-size: 14px;
    color: var(--t-accent);
    background-color: var(--m-steel);
}

/* ================================================================ with the mouse (cuadro 177) */

/* One plate for the players, as the squad's (Mixta.uss .panel.plate--low), in place of a label each. */
.desk .players {
    margin-left: 0;
    padding: 5px 12px 6px 4px;
    background-image: url("/Assets/Synty/InterfaceApocalypseHUD/Sprites/HUD/SPR_HUD_Apocalypse_Box_Medium_01.png");
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.9);
    -unity-slice-scale: 0.6px;
}

.desk .player {
    padding: 2px 2px 3px;
    margin-left: 12px;
    background-color: rgba(0, 0, 0, 0);
}

.desk .player__dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    margin-right: 6px;
}

.desk .player__name {
    font-size: 13px;
}

.desk .player__status,
.desk .player__command {
    margin-left: 7px;
}
