/*
   «Terminar turno» and the turn's clock (hud.ts setEndTurn, tickClocks; UI-COMBATE UI-04, UI-05): the bar's seventh key,
   its steel and grey like the others' (ActionBar.uss .ability), and under the whole row this player's clock alone (Ana,
   7/11 #9).
*/

/* Right after the bar's keys, the same 5 px apart (2.5 a side). */
.end-slot {
    flex-direction: row;
}

/* →| drawn (LineIcon «endTurn»), in the keys' icon box. */
.end-turn .ability__icon {
    width: 28px;
    height: 28px;
}

/* Ready, waiting for the partner: the check, green; a press takes it back. */
.end-turn--ready .ability__icon {
    -unity-background-image-tint-color: var(--t-good);
}

.end-turn--ready {
    border-width: 2px;
    border-color: rgba(143, 208, 90, 0.7);
}

/* The clock: this player's, a bar in their colour as wide as the row of keys (the partner's thin one no longer shows). */
.end-clock {
    margin: 6px 2.5px 0;
}

.turn-clock {
    height: 9px;
    border-radius: 2px;
    overflow: hidden;
}

.turn-clock__fill {
    height: 100%;
    width: 100%;
    background-color: var(--t-accent);
}

/* Still while the screen shows what happened; it moves while it runs. */
.turn-clock--low .turn-clock__fill {
    background-color: var(--t-warn);
}

.turn-clock--out .turn-clock__fill {
    background-color: var(--t-danger);
}
