/*
   The squad's cards under the sheet (UI-COMBATE UI-02; hud.ts setSquad): the bust, the name at its foot, health and
   actions under it filling the card's width; the picked one bigger, all on one foot. Widths from C# (SquadList).
*/

.squad-cards {
    flex-direction: row;
    align-items: flex-end;
}

.squad-card {
    padding: 2px;
    background-color: var(--m-steel-lo);
    border-width: 1px;
    border-radius: 2px;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: var(--m-edge);
    border-bottom-color: var(--m-edge);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.squad-card--mine:hover {
    background-color: var(--m-steel);
    border-top-color: var(--t-accent);
}

/* The soldier's bust (Arte's Portraits, a square drawn in its owner's colour): cropped to the card. */
.squad-card__bust {
    height: 72px;
    overflow: hidden;
    background-color: var(--m-well);
    -unity-background-scale-mode: scale-and-crop;
}

.squad-card--selected .squad-card__bust {
    height: 86px;
}

/* The name on a dark slip along the bust's foot. */
.squad-card__name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1px 4px 0;
    font-size: 11px;
    color: #ffffff;
    background-color: rgba(0, 0, 0, 0.55);
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}

.squad-card--selected .squad-card__name {
    font-size: 13px;
}

/* More than four: the first name, a size smaller, closer to the edges. */
.squad-card--narrow .squad-card__name {
    padding: 1px 2px 0;
    font-size: 10px;
}

.squad-card--narrow.squad-card--selected .squad-card__name {
    font-size: 11px;
}

/* Its states over the bust's top (VIGILANCIA, MORDIDO…): the first two, small; all of them in its help. */
.squad-card__tags {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    align-items: flex-start;
}

.squad-card__tag {
    margin: 0 0 1px;
    padding: 0 3px;
    font-size: 8.5px;
    max-width: 100%;
    overflow: hidden;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Health and actions as wide as the card: a piece a point (the slot's parchment for health), a bar an action. */
.squad-card__hp {
    margin-top: 3px;
    padding: 2px;
}

.squad-card__hp .pip {
    flex-grow: 1;
    width: 0;
    height: 5px;
}

/* (USS has no :last-child: the row reaches past the last bar's margin.) */
.squad-card__ap {
    margin-top: 2px;
    margin-right: -2px;
}

.squad-card__ap .pip {
    flex-grow: 1;
    width: 0;
    height: 3px;
    margin-right: 2px;
}

/* The movement left under the actions, a piece a tile in the reach's sky blue, thinner (Arturo, 5/11 #14). */
.squad-card__moves {
    margin-top: 2px;
    margin-right: -1px;
}

.squad-card__moves .pip {
    flex-grow: 1;
    width: 0;
    height: 2px;
    margin-right: 1px;
}

.pips--moves .pip--on {
    background-color: #5cc4f5;
}

/* The picked one: lit round it. */
.squad-card--selected {
    border-width: 1px;
    border-color: var(--t-accent);
    background-color: var(--m-steel);
}

.squad-card--dead {
    opacity: 0.4;
}

.squad-card--dead .squad-card__name {
    color: var(--t-muted);
}

.squad-card--evacuated {
    opacity: 0.6;
}

.squad-card--in-play {
    border-top-width: 2px;
    border-top-color: var(--t-accent);
}
