<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!--
        A soldier's card under the sheet (UI-COMBATE UI-02; SquadList.cs fills it): the bust, its states over it and its
        name at its foot; its health in green and its actions in yellow under it. Styles: SquadList.uss, from Hud.uxml.
    -->
    <ui:VisualElement name="card" class="squad-card">
        <ui:VisualElement name="bust" class="squad-card__bust" picking-mode="Ignore">
            <ui:VisualElement name="tags" class="squad-card__tags" picking-mode="Ignore" />
            <ui:Label name="name" class="squad-card__name font-title" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="hp" class="pips pips--hp squad-card__hp" picking-mode="Ignore" />
        <ui:VisualElement name="ap" class="pips pips--ap squad-card__ap" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
