/* Where each piece of the combat HUD stands (styles.css of the 0.10.1: --edge 8px; the bottom as UI-COMBATE v1.0, 01/11). */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ================================================================ frame */

.turn-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.turn-frame__edge {
    position: absolute;
    background-color: var(--t-accent);
    opacity: 0.85;
}

.turn-frame__edge--top {
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
}

.turn-frame__edge--bottom {
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
}

.turn-frame__edge--left {
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
}

.turn-frame__edge--right {
    right: 0;
    top: 0;
    bottom: 0;
    width: 3px;
}

/* The partner's turn: thinner and fainter (dashed on the web; USS has no dashed borders: a repeated texture later). */
.turn-frame--partner .turn-frame__edge {
    opacity: 0.5;
}

.turn-frame--over .turn-frame__edge {
    display: none;
}

/* =============================================================== places */

.top {
    position: absolute;
    top: var(--edge);
    left: 232px;
    right: 232px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

/* The squad (UI-COMBATE UI-01, UI-11): one plate bottom left, its foot level with the clock's under the keys. Its width is
   set from C# by the cards (SquadList: a quarter of the screen with four, a little more with up to eight). */
.squad {
    position: absolute;
    left: var(--edge);
    bottom: var(--edge);
    align-items: flex-start;
}

/* The cards' plate: the keys keep clear of it (HudRoot.PlaceActions), not of the sheet's over it. */
.squad-plate {
    padding: 6px 8px 7px;
    /* Straight, as Mixta had it (synty-base.css: «Straight, not crooked»). */
    rotate: 0deg;
}

/* With the finger (docs/IOS.md, phase 2): the plate up on the left, under the top strip, its cards two a row (SquadList),
   so that the keys have the foot of the screen to themselves on a Duo open (1001 × 704). */
.touch .squad {
    top: 64px;
    bottom: auto;
}

/* The keys and «Terminar turno» in one row, the clock under them as wide (UI-04, UI-05): as wide as its row, its middle at
   the screen's (HudRoot moves it right when the squad's plate would reach it). */
.actions {
    position: absolute;
    bottom: var(--edge);
    left: 50%;
    translate: -50% 0;
    align-items: stretch;
}

.actions__row {
    flex-direction: row;
    align-items: flex-end;
}

.abilities {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.shot-panel {
    position: absolute;
    right: var(--edge);
    top: 50%;
    translate: 0 -50%;
    rotate: 0deg;
    width: 236px;
    padding: 8px 10px;
}

.side {
    position: absolute;
    right: var(--edge);
    top: var(--edge);
    width: var(--side-w);
    align-items: flex-end;
}

.side > * {
    margin-bottom: 5px;
}

.flags-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

/* Over the keys and their slips (the keys stand on the clock: 8 + 14 + 60, a slip 14 over them). */
.notes {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 104px;
    align-items: center;
}

/* Over a menu open on the bar (ActionBar.uss .ability-menu: 68px over the keys, a key and its padding tall). */
.notes--over-menu {
    bottom: 166px;
}

.cards {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* Behind the arrival card, over the whole screen and clear: a click by the way doesn't play the map under it
   (hud.ts .intro-catcher; Ana, 20/10 #32). */
.card-catcher {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* What ending the turn would leave unspent, blinking (HudRoot.PointOut; Arturo, 15/11): the picked one's actions, its
   movement on the bar, the cards of those with anything left. Its colours only: nothing changes size (Arturo, 18/11 T13:
   a wider border and a scale moved the other keys of the bar at each blink). */
.hud-point,
.bar-moves.hud-point,
.squad-card.hud-point,
.stat.hud-point {
    background-color: rgba(255, 255, 255, 0.45);
    border-color: #ffffff;
}

/* ================================================================ a chapter's boss (BossBar, H6) */

.boss-bar {
    position: absolute;
    top: 64px;
    left: 30%;
    right: 30%;
    padding: 6px 12px 8px 12px;
    background-color: rgba(18, 12, 12, 0.92);
    border-width: 1px;
    border-color: #6b1d16;
}

.boss-bar__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.boss-bar__name {
    font-size: 20px;
    color: #ffffff;
    letter-spacing: 2px;
}

.boss-bar__hp {
    font-size: 16px;
    color: #f0d0c8;
}

.boss-bar__track {
    height: 10px;
    margin-top: 4px;
    background-color: rgba(255, 255, 255, 0.1);
}

.boss-bar__fill {
    height: 100%;
    background-color: #c0392b;
}

.boss-bar__line {
    flex-direction: row;
    margin-top: 5px;
}

.boss-bar__chip {
    font-size: 11px;
    color: #c4c9c0;
    margin-right: 10px;
}

.boss-bar__chip--ready {
    color: #ff8a7a;
}
