/* Over the units (unitViews.ts renderFlag, the CSS was UI's): name, health, armour, cover, states; floating numbers. */

/* Its bottom middle stands over the unit's head (UnitFlags places it each frame with translate, from its size). */
.uflag {
    position: absolute;
    left: 0;
    top: 0;
    align-items: center;
}

.uflag__name {
    font-size: 11px;
    -unity-font-style: bold;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.uflag--enemy .uflag__name {
    color: #ff8a7a;
}

.uflag__row {
    flex-direction: row;
    align-items: center;
    padding: 1px 3px;
    background-color: rgba(10, 12, 13, 0.75);
    border-radius: 1px;
}

.uflag--enemy .pip--on {
    background-color: var(--t-danger);
}

.uflag--enemy .pips--hp .pip--on {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--t-danger);
}

.uflag__armor {
    flex-direction: row;
    margin-left: 3px;
}

.uflag__armor-pip {
    width: 6px;
    height: 7px;
    margin-right: 1px;
    background-color: #9fb8c8;
}

/* Cover: high, low, flanked (a shield's sprite later; a coloured block until then). */
.uflag__cover {
    width: 10px;
    height: 10px;
    margin-right: 3px;
}

.uflag__cover--2 {
    background-color: #7fd3ff;
}

.uflag__cover--1 {
    background-color: #ffcf5a;
}

.uflag__cover--0 {
    background-color: var(--t-danger);
}

.uflag .tag {
    font-size: 9px;
}

/* The hover line over an enemy, from the tile under the pointer: its odds, sight or flank. */
.uflag__hover {
    margin-bottom: 2px;
    padding: 0 5px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: var(--t-tag);
}

.uflag__hover--aim {
    color: var(--t-accent);
}

.uflag__hover--sight {
    color: #7fd3ff;
}

.uflag__hover--flank {
    color: var(--t-danger);
}

/* Over the shoulder only the target's flag stays (styles.css .labels-layer.close-shot). */
.flags-layer--close .uflag {
    display: none;
}

.flags-layer--close .uflag--target {
    display: flex;
}

/* Floating numbers and words (fx.ts floatText: now UI's), risen and faded from C#. */
.float {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

.float--damage {
    color: #ff6b5a;
}

.float--crit {
    font-size: 20px;
    color: var(--t-accent);
}

.float--info {
    font-size: 12px;
    color: #c9d4dc;
}

.float--warn {
    font-size: 13px;
    color: var(--t-warn);
}

.float--callout {
    font-size: 14px;
    padding: 1px 8px;
    color: var(--t-text);
    background-color: rgba(120, 20, 14, 0.9);
}

/* A weapon found: its picture before the word, in the word's colour (Ana's notes, Arturo 29/10). */
.float--icon {
    flex-direction: row;
    align-items: center;
}

.float__icon {
    width: 30px;
    height: 18px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--t-text);
}

/* An enemy that sees one of the squad (styles.css .uflag.watching): an eye at the row's start, only its outline and
   pupil in the muted text (Ana, Arturo 29/10: the stamp's red one was too loud). */
.uflag__eye {
    width: 13px;
    height: 8px;
    margin-right: 3px;
    color: var(--t-muted);
}

/* Whose ping it is (styles.css .ping-tag): white on the player's colour, darkened, a ring of it round. */
.pin {
    position: absolute;
    left: 0;
    top: 0;
    padding: 2px 7px;
    font-size: 13px;
    -unity-font-style: bold;
    color: #ffffff;
    border-width: 2px;
    border-radius: 2px;
    white-space: nowrap;
}

/* The line on the tile under the pointer (styles.css .tile-note): a small plate, a warning-coloured edge at its left. */
.tile-note {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0 6px;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
    background-color: var(--t-tag);
    border-left-width: 3px;
    border-left-color: var(--t-warn);
}

/* Tags that stay over the map (overlays.ts break-bar, pack-tag): under the flags, gone over the shoulder. */
.wtag {
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    border-radius: 2px;
    background-color: rgba(14, 16, 17, 0.82);
}

.flags-layer--close .wtag {
    display: none;
}

.wtag__text {
    font-size: 11px;
    -unity-font-style: bold;
    color: #f2efe6;
}

/* A door's or a barricade's bar: what it still holds, red at a third. */
.wtag__track {
    width: 28px;
    height: 5px;
    margin-right: 4px;
    background-color: rgba(255, 255, 255, 0.16);
}

.wtag__fill {
    height: 100%;
    background-color: #d9a441;
}

.wtag--low .wtag__fill {
    background-color: #ff5a4a;
}

.wtag--low .wtag__text {
    color: #ff8a7a;
}

/* A fallen soldier's rucksack: «MOCHILA DE CHIARA» on a dark plate with a sand line under it (styles.css .pack-tag). */
.wtag--pack {
    padding: 1px 6px;
    border-bottom-width: 2px;
    border-bottom-color: #c9b48a;
}

.wtag--pack .wtag__text {
    color: #efe6d2;
    letter-spacing: 0.5px;
}

/* A loot box's mark (lootMarks.ts): the icon of what is in it on a plate of the interface's dark steel, ringed in its
   colour (set inline), scaled with the camera to the map's size. */
.wtag--loot {
    width: 64px;
    height: 64px;
    padding: 0;
    justify-content: center;
    border-width: 5px;
    border-radius: 32px;
    background-color: rgba(27, 30, 32, 0.94);
}

/* A little short of white, so the bloom leaves it be. */
.wtag__icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.86);
}
