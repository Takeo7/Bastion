/* The map from above (MiniMap.cs; Arturo, 31/10 #12 and 01/11: the camera straight down over all of it): while it is up
   there, a strip at the top that says so and what a click, M and Esc do (M alone opens it: UI-COMBATE v1.0). */
.mini-map {
    position: absolute;
    left: 0;
    right: 0;
    top: 52px;
    flex-direction: row;
    justify-content: center;
}

.mini-map__strip {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
}

.mini-map__title {
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--t-accent);
}

.mini-map__hint {
    margin-left: 16px;
    font-size: 12px;
    color: var(--t-muted);
}
