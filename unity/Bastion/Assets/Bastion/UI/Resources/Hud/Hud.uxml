<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!--
        The combat HUD (hud.ts of the 0.10.1): one holder per piece, each filled by its class (Scripts/Hud/Pieces).
        The style sheets go here, on the root, and reach the templates cloned under it (SquadCard, AbilityButton…).
        Holders that only place things let the clicks through to the map (picking-mode Ignore).
    -->
    <Style src="Mixta.uss" />
    <Style src="Hud.uss" />
    <Style src="SquadList.uss" />
    <Style src="UnitPanel.uss" />
    <Style src="ActionBar.uss" />
    <Style src="ShotPanel.uss" />
    <Style src="TurnStrip.uss" />
    <Style src="TurnActions.uss" />
    <Style src="GoalCard.uss" />
    <Style src="Log.uss" />
    <Style src="Flags.uss" />
    <Style src="Cards.uss" />
    <Style src="EdgeMarks.uss" />
    <Style src="GameMenu.uss" />
    <Style src="MiniMap.uss" />
    <ui:VisualElement name="hud" class="hud font-text" picking-mode="Ignore">
        <!-- Round the screen, in the colour of whoever plays now. -->
        <ui:VisualElement name="turn-frame" class="turn-frame" picking-mode="Ignore">
            <ui:VisualElement class="turn-frame__edge turn-frame__edge--top" picking-mode="Ignore" />
            <ui:VisualElement class="turn-frame__edge turn-frame__edge--right" picking-mode="Ignore" />
            <ui:VisualElement class="turn-frame__edge turn-frame__edge--bottom" picking-mode="Ignore" />
            <ui:VisualElement class="turn-frame__edge turn-frame__edge--left" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- Over the units: their flags, the hover lines, the floating numbers (under every panel). -->
        <ui:VisualElement name="flags" class="flags-layer" picking-mode="Ignore" />
        <!-- Arrows at the screen's edge towards the marks off it (the objective, the evacuation, the partner's moment). -->
        <ui:VisualElement name="edge-marks" class="edge-marks" picking-mode="Ignore" />
        <!-- The night and the soldier in play (a partner's turn), and the players: no turn tab, no floors (UI-COMBATE UI-03, UI-10). -->
        <ui:VisualElement name="top" class="top" picking-mode="Ignore">
            <ui:VisualElement name="turn" class="turn" picking-mode="Ignore" />
            <ui:VisualElement name="players" class="players" picking-mode="Ignore" />
        </ui:VisualElement>
        <!--
            The squad, bottom left (UI-01, UI-02): the backpack's slots over the sheet's end, the picked soldier's sheet in one
            row on a plate of its own (Ana, 7/11 #13: as wide as it needs, over the keys' height), the cards on theirs.
        -->
        <ui:VisualElement name="squad" class="squad" picking-mode="Ignore">
            <ui:VisualElement name="pack" class="unit-pack" picking-mode="Ignore" />
            <ui:VisualElement name="unit-panel" class="unit-panel panel" />
            <ui:VisualElement name="squad-plate" class="squad-plate panel">
                <ui:VisualElement name="squad-cards" class="squad-cards" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- The keys and «Terminar turno» in one row, the turn's clock under all of it (UI-04, UI-05). -->
        <ui:VisualElement name="actions" class="actions" picking-mode="Ignore">
            <ui:VisualElement class="actions__row" picking-mode="Ignore">
                <ui:VisualElement name="abilities" class="abilities" picking-mode="Ignore" />
                <ui:VisualElement name="end-slot" class="end-slot" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="clocks" class="end-clock" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="shot-panel" class="shot-panel panel" />
        <!-- Where the mission's goal lies, an arrow in a ring, bottom right (UI-06). -->
        <ui:VisualElement name="goal-arrow" class="goal-arrow" picking-mode="Ignore" />
        <!-- The enemies' sight beside it, a button that stays on, and the legend of its red over them (Arturo, 5/11 #6, #9). -->
        <ui:VisualElement name="sight" class="sight" picking-mode="Ignore" />
        <ui:VisualElement name="side" class="side" picking-mode="Ignore">
            <ui:VisualElement name="goal" class="goal-dock panel" />
            <ui:VisualElement name="compass" class="compass panel" />
            <ui:VisualElement name="log" class="log panel" />
        </ui:VisualElement>
        <ui:VisualElement name="banner" class="banner" />
        <ui:VisualElement name="notes" class="notes" picking-mode="Ignore" />
        <!-- The camera up over the map (M): what it is and what to do, under the turn's strip. -->
        <ui:VisualElement name="mini-map" class="mini-map" picking-mode="Ignore" />
        <!-- The cards in the middle: the partner's call, the arrival, the outcome. -->
        <ui:VisualElement name="cards" class="cards" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
