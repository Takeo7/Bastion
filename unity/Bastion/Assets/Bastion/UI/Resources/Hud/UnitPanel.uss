/*
   The picked soldier's sheet, one row over the cards (UI-COMBATE UI-02; hud.ts setSelected; Ana, 7/11 #13): who, its
   weapon, its rounds, its figures with their icons, a thin line between the groups, the backpack's mark at its end.
*/

/* On a torn plate of its own over the cards' (Hud.uxml), as wide as its row needs. */
.unit-panel {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    margin-bottom: 4px;
    padding: 5px 10px;
    min-height: 28px;
}

/* Nothing in the row shrinks: the plate grows to it instead (SquadList). */
.unit-panel > * {
    flex-shrink: 0;
}

.unit-head {
    flex-direction: row;
    align-items: center;
}

.unit-head--opens:hover .unit-name {
    color: var(--t-accent);
}

.unit-head__name-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.unit-name {
    font-size: 14px;
    margin-right: 4px;
    white-space: nowrap;
}

.unit-class {
    font-size: 9px;
    letter-spacing: 0.4px;
    white-space: nowrap;
}

/* Its cover's shield (CoverShield; Arturo, 7/11): Synty's shield (Ana, 7/11 #2), tinted with the cover's colour. */
.cover-shield {
    width: 16px;
    height: 16px;
    margin-left: 7px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* «DE ANA»: in the partner's colour (set from C#). */
.whose {
    margin-left: 0;
}

/* Veterancy chevrons: a small stack of marks before the name. */
.rank {
    flex-direction: column;
    margin-right: 5px;
}

.rank__chevron {
    width: 10px;
    height: 3px;
    margin-bottom: 1px;
    background-color: var(--t-accent);
}

/* The weapon behind a thin line; its figures after it, or on a second line when they don't fit (no line before them, so
   none is left at the second line's start). */
.unit-weapon {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
    padding-left: 6px;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.18);
}

.unit-stats {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    margin-left: 6px;
    padding-left: 6px;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.18);
}

.stat {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-right: 6px;
}

/* The first figure past the rounds: a thin line before it (Ana, 7/11 #13). */
.stat--group {
    padding-left: 6px;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.18);
}

/* The figure's icon (Synty INTERFACE sprites, tinted). */
.stat-icon {
    width: 14px;
    height: 14px;
    margin-right: 3px;
    -unity-background-image-tint-color: var(--t-muted);
}

/* An aim's word before its number (B24): «PUNT. 55»; with the finger, only the weapon in hand's (the strip is tight). */
.stat__word {
    margin-left: 2px;
    font-size: 10px;
    letter-spacing: 0.5px;
    color: var(--t-muted);
}

.touch .stat__word--spare {
    display: none;
}

.stat__value {
    font-size: 12px;
    -unity-font-style: bold;
    margin-left: 2px;
}

.stat__value--bad {
    color: var(--t-danger);
}

.unit-weapon__name {
    font-size: 11.5px;
    color: var(--t-muted);
    white-space: nowrap;
}

/* The backpack's mark at the row's end, its pockets over it once pressed; what the squad carries in its help. */
/* The backpack's key (Arturo, 18/11 T11: it was a loose picture that didn't look pressable): a plate with a bevel, as the
   bar's keys, the picture and «MOCHILA»; lit while the pockets are shown. */
.unit-pack-mark {
    margin-left: auto;
    flex-direction: row;
    align-items: center;
    padding: 2px 8px 2px 6px;
    background-color: var(--t-panel-hi);
    border-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.28);
    border-left-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(0, 0, 0, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.7);
    border-radius: 2px;
}

.unit-pack-mark:hover {
    background-color: var(--t-panel-hover);
    border-top-color: rgba(255, 255, 255, 0.5);
}

.unit-pack-mark__label {
    margin-left: 5px;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--t-text);
}

.unit-pack-mark--open {
    background-color: var(--t-primary);
    border-top-color: #ffffff;
}

.unit-pack-mark--open .unit-pack-mark__label {
    color: var(--t-primary-ink);
}

.unit-pack-mark--open .unit-pack-mark__icon {
    -unity-background-image-tint-color: var(--t-primary-ink);
}

.unit-pack-mark__icon {
    width: 16px;
    height: 18px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--t-text);
}

.unit-pack-mark:hover .unit-pack-mark__icon {
    -unity-background-image-tint-color: var(--t-accent);
}

.unit-pack-mark--open:hover .unit-pack-mark__icon {
    -unity-background-image-tint-color: var(--t-primary-ink);
}

/* A weapon of the Armería's state and improvements (strategy.css .wmarks): «GASTADA», «ROTA», «+2». */
.weapon-marks {
    flex-direction: row;
    margin-left: 6px;
}

.weapon-mark {
    margin-right: 4px;
    padding: 0 4px;
    border-radius: 2px;
    font-size: 10.5px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
}

.weapon-mark--worn {
    background-color: rgba(255, 255, 255, 0.22);
    color: var(--t-warn);
}

.weapon-mark--broken {
    background-color: rgba(240, 80, 60, 0.26);
    color: var(--t-danger);
}

.weapon-mark--mods {
    background-color: var(--t-accent-soft);
    color: var(--t-accent);
}

/* ============================================================== backpack */

/* The backpack (styles.css .unit-pack; UI-COMBATE v1.0): over the plate's frame at the sheet's end, what is on the floor
   over its slots. */
.unit-pack {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 100%;
    margin-bottom: 10px;
    align-items: flex-end;
}

/* With the finger the sheet is up at the top (Hud.uss .touch .squad): over it the slots fell behind the players' strip
   (Arturo's Duo, 8/11). Under the sheet instead, right of the cards' plate (SquadList: two cards of 82 a row, 186 wide). */
.touch .unit-pack {
    bottom: auto;
    top: 40px;
    left: 196px;
    right: auto;
    margin-bottom: 0;
    align-items: flex-start;
}

.pack-slots {
    flex-direction: row;
    flex-shrink: 0;
}

/* A slot: a dark well, its kind's colour as a line along its foot (--c), its number and icon in that colour; bigger than
   they were (Ana, 7/11 #13). */
.pack-slot {
    width: 42px;
    height: 30px;
    margin-right: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0.42);
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
}

.pack-slot--empty {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    opacity: 0.7;
}

.pack-slot__n {
    font-size: 16px;
    letter-spacing: 0;
}

.pack-slot__icon {
    width: 20px;
    height: 20px;
}

.pack-slot__icon--small {
    width: 15px;
    height: 15px;
    margin-left: 2px;
}

.pack-slot__icon--weapon {
    width: 30px;
}

.pack-slot--supplies { border-bottom-color: rgba(255, 210, 90, 0.7); }
.pack-slot--medicines { border-bottom-color: rgba(143, 208, 90, 0.7); }
.pack-slot--item { border-bottom-color: rgba(255, 255, 255, 0.7); }
.pack-slot--food { border-bottom-color: rgba(234, 185, 108, 0.7); }
.pack-slot--parts { border-bottom-color: rgba(178, 195, 208, 0.7); }

/* A weapon found glows faintly purple: for the Armería. */
.pack-slot--weapon {
    background-color: rgba(255, 255, 255, 0.13);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.65);
}

.pack-slot--supplies .pack-slot__n, .pack-total--supplies .pack-total__n { color: #ffd25a; }
.pack-slot--medicines .pack-slot__n, .pack-total--medicines .pack-total__n { color: var(--t-good); }
.pack-slot--item .pack-slot__n, .pack-total--item .pack-total__n { color: var(--t-accent); }
.pack-slot--food .pack-slot__n, .pack-total--food .pack-total__n { color: #eab96c; }
.pack-slot--parts .pack-slot__n, .pack-total--parts .pack-total__n { color: #b2c3d0; }
.pack-slot--weapon .pack-slot__n, .pack-total--weapon .pack-total__n { color: #ffffff; }

.pack-slot--medicines .pack-slot__icon, .pack-total--medicines .pack-total__icon { -unity-background-image-tint-color: var(--t-good); }
.pack-slot--item .pack-slot__icon, .pack-total--item .pack-total__icon { -unity-background-image-tint-color: var(--t-accent); }
.pack-slot--food .pack-slot__icon, .pack-total--food .pack-total__icon { -unity-background-image-tint-color: #eab96c; }
.pack-slot--parts .pack-slot__icon, .pack-total--parts .pack-total__icon { -unity-background-image-tint-color: #b2c3d0; }
.pack-slot--weapon .pack-slot__icon, .pack-total--weapon .pack-total__icon { -unity-background-image-tint-color: #ffffff; }

/* One's own soldier's slot is a button: lit on hover and while its menu is open. */
.pack-slot-btn {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* Over Mixta's Button:hover, which would fill it with steel. */
.pack-slot-btn:hover {
    background-color: rgba(0, 0, 0, 0);
}

.pack-slot-btn:hover .pack-slot,
.pack-slot-btn--open .pack-slot {
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--t-accent);
    border-left-color: var(--t-accent);
    border-right-color: var(--t-accent);
}

/* The backpack mark's help: how full it is, and what the whole squad carries («ESCUADRA 12§ 3▣ ×2»). */
.pack-haul {
    width: 240px;
}

.pack-haul__line {
    font-size: 12px;
    white-space: normal;
}

.pack-haul__line--muted {
    color: var(--t-muted);
}

.pack-squad {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
}

.pack-squad__title {
    flex-shrink: 0;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--t-muted);
    margin-right: 5px;
}

.pack-squad__none {
    color: var(--t-muted);
}

/* Many kinds carried: they go on in a second line, to the right. */
.pack-totals {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    flex-shrink: 1;
}

.pack-total {
    flex-direction: row;
    align-items: center;
    margin-left: 5px;
}

.pack-total__n {
    font-size: 12px;
    letter-spacing: 0;
}

.pack-total__icon {
    width: 11px;
    height: 11px;
    margin-right: 1px;
}

.pack-total__icon--after {
    margin-right: 0;
    margin-left: 1px;
}

.pack-total--weapon .pack-total__icon {
    width: 16px;
}

/* What lies on its tile: «EN EL SUELO», a fallen soldier's rucksack with its order, each thing a button. */
.pack-floor {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 4px;
}

.pack-floor__title {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--t-muted);
    margin-right: 6px;
}

/* Its mark, and its order beside it, or under it when the name is long. */
.pack-fallen {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 2px 0 3px;
}

.pack-fallen__mark {
    font-size: 12px;
    color: var(--t-text);
    margin-right: 8px;
}

.pack-fallen__take {
    margin: 2px 0 0;
    padding: 1px 8px;
    font-size: 12px;
    flex-shrink: 1;
    white-space: normal;
}

.pack-floor-item {
    flex-direction: row;
    align-items: center;
    margin: 0 6px 3px 0;
    padding: 1px 7px;
    border-width: 1px;
    border-radius: 2px;
    border-color: rgba(255, 255, 255, 0.7);
    background-color: rgba(255, 255, 255, 0.08);
}

.pack-floor-item:disabled {
    opacity: 0.6;
}

.pack-floor-item:hover,
.pack-floor-item--open {
    background-color: rgba(255, 255, 255, 0.18);
}

.pack-floor-item__label {
    font-size: 12px;
    margin-right: 5px;
}

.pack-floor-item__act {
    font-size: 10.5px;
    -unity-font-style: bold;
    color: var(--t-accent);
}

/* The menu over the backpack (mixta-hud.css .pack-menu): riveted steel, a line per order, its cost or why not. */
.pack-menu {
    position: absolute;
    right: 0;
    bottom: 100%;
    margin-bottom: 6px;
    /* A fixed width, not min/max: so a reason on two lines is measured as two (with the width open, Unity measured one
       and the menu came out a line short). The longest name and reason fit. */
    width: 290px;
    padding: 8px;
    border-radius: 2px;
    background-color: var(--m-steel);
    border-width: 1px;
    border-color: var(--m-edge);
    border-top-color: var(--m-steel-hi);
}

/* No line of the menu gives up height: a reason on two lines made the column squeeze its title. */
.pack-menu__head {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px 3px;
}

.pack-menu__title {
    font-size: 14px;
    color: #ffffff;
    flex-shrink: 1;
    white-space: normal;
}

.pack-menu__x {
    margin: 0 0 0 8px;
    padding: 0 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--t-muted);
}

.pack-menu__x:hover {
    background-color: rgba(0, 0, 0, 0);
    color: var(--t-text);
}

.pack-act {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 3px 0 0;
    padding: 4px 8px;
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--m-edge);
    border-top-color: var(--m-steel-hi);
    background-color: #2f3436;
}

.pack-act:hover {
    background-color: #3a4043;
    border-color: rgba(255, 255, 255, 0.55);
}

.pack-act--main {
    background-color: #3f3920;
    border-color: rgba(255, 255, 255, 0.7);
}

.pack-act--main:hover {
    background-color: #4a4325;
}

.pack-act__label {
    flex-shrink: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--t-text);
}

.pack-act--main .pack-act__label {
    color: #ffe9a6;
}

/* Its cost, or why not: on two lines, to the right, when a long reason doesn't fit beside a long name. */
.pack-act__cost {
    flex-shrink: 1;
    margin-left: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: normal;
    color: var(--t-muted);
}

.pack-act:disabled {
    opacity: 1;
}

.pack-act:disabled .pack-act__label {
    color: var(--t-muted);
}

.pack-act:disabled .pack-act__cost {
    color: var(--t-warn);
}

/* ================================================================ with the mouse (cuadro 177) */

/* «PUNT.» and «CaC» go: their icons, lit, and their figures say it (their help, the whole of it). */
.desk .stat__word {
    display: none;
}

.desk .unit-panel {
    padding: 6px 8px 6px 12px;
    min-height: 32px;
}

.desk .unit-name {
    font-size: 15px;
    margin-right: 2px;
}

.desk .cover-shield {
    margin-left: 8px;
}

.desk .unit-weapon,
.desk .unit-stats {
    margin-left: 10px;
    padding-left: 10px;
    border-left-color: rgba(255, 255, 255, 0.2);
}

.desk .stat--group {
    padding-left: 10px;
    margin-left: 2px;
}

.desk .stat {
    margin-right: 8px;
}

.desk .unit-weapon__name {
    font-size: 12.5px;
    color: var(--t-text);
}

.desk .stat-icon {
    width: 15px;
    height: 15px;
    margin-right: 4px;
    -unity-background-image-tint-color: var(--t-text);
}

.desk .stat__value {
    font-size: 13.5px;
    margin-left: 0;
}

.desk .unit-pack-mark {
    margin-left: 4px;
}

/* ================================================================ the sheet inside its card (cuadro 179) */

/*
   With the mouse (UnitPanel.InCard; SquadList docks it): no plate of its own, a column to the right of the bust. The
   gun's picture and its name; the health and the actions, a bar each with its icon; the rounds, the cover's shield and
   the states; «MOCHILA». The name, the rank and the aims are the card's help.
*/
.unit-panel--in-card {
    width: 186px;
    min-height: 0;
    margin: 0 0 0 10px;
    padding: 4px 8px 3px 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    background-image: none;
}

.unit-panel--in-card .unit-head__name-row,
.unit-panel--in-card .stat--aim,
.unit-panel--in-card .stat--melee {
    display: none;
}

.unit-panel--in-card .unit-weapon,
.unit-panel--in-card .unit-stats {
    margin-left: 0;
    padding-left: 0;
    border-left-width: 0;
}

.unit-panel--in-card .unit-gun {
    width: 70px;
    height: 26px;
    margin-right: 8px;
    flex-shrink: 0;
}

.unit-panel--in-card .unit-weapon__name {
    font-size: 13px;
    white-space: normal;
    flex-shrink: 1;
}

.unit-bars .stat {
    margin: 0 0 4px 0;
}

.unit-panel--in-card .unit-bars .stat-icon {
    width: 16px;
    height: 16px;
    margin-right: 7px;
}

.unit-bars .pips {
    flex-grow: 1;
}

.unit-bars .stat--hp .pips {
    padding: 3px 4px;
}

.unit-bars .stat--hp .pip {
    flex-grow: 1;
    width: 0;
    height: 9px;
    margin-right: 2px;
}

.unit-bars .stat--ap .pip {
    flex-grow: 1;
    width: 0;
    height: 7px;
    margin-right: 3px;
}

.unit-has {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.unit-panel--in-card .unit-stats {
    flex-wrap: wrap;
}

.unit-panel--in-card .unit-has .stat {
    margin-right: 12px;
}

.unit-panel--in-card .unit-has .stat-icon {
    width: 18px;
    height: 18px;
    margin-right: 5px;
}

.unit-panel--in-card .pips--ammo .pip {
    width: 5px;
    height: 15px;
    margin-right: 3px;
}

.unit-panel--in-card .unit-has .stat__value {
    font-size: 15px;
    margin-left: 3px;
}

.unit-panel--in-card .cover-shield {
    width: 22px;
    height: 22px;
    margin: 0 8px 0 0;
}

.unit-panel--in-card .unit-head {
    flex-wrap: wrap;
    flex-shrink: 1;
}

.unit-panel--in-card .unit-state {
    margin-right: 5px;
    margin-bottom: 1px;
}

.unit-panel--in-card .unit-pack-mark {
    margin-left: 0;
    padding: 5px 13px 5px 9px;
    align-self: flex-start;
}

.unit-panel--in-card .unit-pack-mark__label {
    font-size: 13px;
}

/* The backpack's slots over the sheet (SquadList sets where), from its left. */
.desk .unit-pack {
    right: auto;
    align-items: flex-start;
}
