/* The stamp (hud.ts banner), the cards in the middle (call, arrival, outcome) and the notes (toast, notice). */

/* ================================================================ banner */

/*
   Coming down: a little big and faint, then its size, in one quick step (the transition). As the «LEVEL UP» Ana showed
   (7/11 #8): a black plate, its steel's grain faint, a thin white line near its top and its foot, the title white and in
   capitals, the same on the squad's turn and the enemy's; no hazard bands, no arrow.
*/
.banner {
    position: absolute;
    top: 24%;
    left: 0;
    right: 0;
    align-items: center;
    opacity: 0;
    scale: 1.25 1.25;
    transition-property: opacity, scale;
    transition-duration: 0.14s, 0.14s;
    transition-timing-function: ease-in, ease-in;
}

.banner--show {
    opacity: 1;
    scale: 1 1;
}

.banner__plate {
    align-items: center;
    min-width: 420px;
    max-width: 640px;
    padding: 0 56px;
    background-color: rgba(6, 7, 8, 0.94);
    background-image: url("../../Textures/steel-plate.png");
    background-repeat: repeat repeat;
    background-size: 256px 256px;
    -unity-background-image-tint-color: rgba(40, 42, 44, 0.9);
}

/* The thin white lines, inset a little from the plate's ends. */
.banner__line {
    align-self: stretch;
    height: 2px;
    margin: 9px -40px 12px -40px;
    background-color: rgba(255, 255, 255, 0.85);
}

.banner__line--bottom {
    margin: 12px -40px 9px -40px;
}

.banner__text {
    font-size: 42px;
    letter-spacing: 2px;
    color: #ffffff;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
}

/* A danger's (a soldier rises, the alarm, more coming): its title red; the turns' always white. */
.banner--alien .banner__text {
    color: rgb(240, 80, 60);
}

.banner__detail {
    margin-top: 2px;
    font-size: 15px;
    color: var(--t-text);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* «Clic para seguir»: small, white faded (styles.css .banner-go: opacity 0.6). */
.banner__go {
    margin-top: 4px;
    font-size: 11px;
    letter-spacing: 1px;
    color: #ffffff;
    opacity: 0.6;
}

/* ================================================================= cards */

.card {
    width: 520px;
    padding: 16px 28px 18px;
}

.card > * {
    margin-bottom: 8px;
}

.card__kicker {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--t-accent);
}

.card__title {
    font-size: 30px;
    letter-spacing: 1px;
    white-space: normal;
}

.card__text {
    font-size: 14px;
    white-space: normal;
}

.card__objective {
    font-size: 15px;
    white-space: normal;
}

.card__turns {
    font-size: 13px;
    color: var(--t-accent);
}

.card__actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.card__actions Button {
    margin-left: 6px;
    height: 34px;
}

.card__clock {
    font-size: 13px;
    color: var(--t-warn);
}

/* The arrival card shrinking into the objective's card (Intro.Close: towards the top right). */
.card--intro {
    transition-property: opacity, scale, translate;
    transition-duration: 0.35s, 0.35s, 0.35s;
}

.card--leaving {
    opacity: 0;
    scale: 0.3 0.3;
    translate: 40% -45%;
}

.outcome__title {
    font-size: 44px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.outcome--victory .outcome__title {
    color: var(--t-good);
}

.outcome--defeat .outcome__title {
    color: var(--t-danger);
}

.outcome__line {
    -unity-text-align: middle-center;
}

/* ================================================================= notes */

.note {
    margin-top: 4px;
    padding: 3px 12px;
    font-size: 18px;
    background-color: var(--t-tag);
    rotate: -1deg;
}

/* A key moment of the partner's, with «Ver (F)», in their colour (border set from C#). */
.note--partner {
    flex-direction: row;
    align-items: center;
    font-size: 15px;
    border-left-width: 3px;
}

.note--partner Button {
    margin-left: 8px;
}

/* A find left on the floor with the backpack full (hud.ts packOffer), with «Cambiar»: higher, over the partner's. */
.note--offer {
    flex-direction: row;
    align-items: center;
    font-size: 15px;
    margin-bottom: 44px;
    border-left-width: 3px;
    border-left-color: var(--t-accent);
    rotate: 0deg;
}

.note--offer Button {
    margin-left: 8px;
}
