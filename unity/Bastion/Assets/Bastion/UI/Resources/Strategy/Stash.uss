/*
 * Almacén, the runs' base (StashScreen): the stash's plate on the left, as wide as its ten cells; the chosen soldier's
 * kit on the right; the clearing between them. The grids themselves are Gear/Gear.uss.
 */

.stash-left {
    width: 562px;
}

.stash-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.stash-supplies {
    flex-direction: row;
    align-items: center;
}

.stash-supplies__icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
    -unity-background-image-tint-color: #d8cfb4;
}

.stash-supplies__value {
    font-size: 20px;
}

.stash-hint {
    font-size: 12px;
    white-space: normal;
    margin-top: 8px;
}

.stash-bin {
    margin-top: 10px;
    align-self: flex-start;
}

.stash-right {
    width: 300px;
    bottom: auto;
}

.stash-chooser {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

/*
 * A soldier to choose (Almacén, the map's squad): their bust on its studio's light as Soldados' tiles, the name under it,
 * and in a run the health under that; all as wide as each other (Arturo, 18/11 T5 and T10: by name, a longer name made a
 * longer bar, and looked like more health).
 */
.stash-tab {
    flex-direction: column;
    align-items: stretch;
    width: 62px;
    margin: 0 4px 4px 0;
    padding: 0;
    font-size: 11px;
    color: #a1a79d;
    background-color: rgba(8, 9, 10, 0.88);
    background-image: none;
    border-width: 1px;
    border-color: #060708;
    border-radius: 0;
}

.stash-tab:hover {
    color: #eef0ea;
}

.stash-tab--on {
    color: #15181a;
    background-color: #ffffff;
    border-color: #ffffff;
}

.stash-tab--theirs {
    opacity: 0.75;
}

.stash-tab__face {
    height: 52px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
}

.stash-tab__bust {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-and-crop;
}

.stash-tab__silhouette {
    width: 28px;
    height: 28px;
    -unity-background-image-tint-color: rgba(201, 205, 198, 0.35);
}

.stash-tab__label {
    padding: 2px 2px 3px;
    color: #a1a79d;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.stash-tab:hover .stash-tab__label {
    color: #eef0ea;
}

/* The chosen one's band lit, its name dark on it (as Soldados' tiles). */
.stash-tab--on .stash-tab__label,
.stash-tab--on:hover .stash-tab__label {
    color: #15181a;
}

/* In a run, each one's health under the name, the bar as wide as the tile. */
.stash-tab__hp {
    height: 3px;
    margin: 0 4px 4px;
    background-color: rgba(255, 255, 255, 0.12);
}

.stash-tab--on .stash-tab__hp {
    background-color: rgba(0, 0, 0, 0.18);
}

.stash-tab__fill {
    height: 100%;
    background-color: #8fd05a;
}

.stash-tab__fill--low {
    background-color: #f0503c;
}

/* The head and, on the map, the fold's key at its right (cuadro 132). */
.kit-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.kit-head {
    margin-bottom: 6px;
}

.kit-fold {
    margin: 0;
    padding: 2px 8px;
    font-size: 12px;
    color: #8fd05a;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.kit-fold:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
}

.stash-name {
    font-size: 20px;
}

.stash-line {
    font-size: 13px;
    margin-bottom: 4px;
}

.stash-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 8px;
}

.stash-row--tight {
    margin-top: 2px;
}

.stash-place {
    margin-right: 10px;
}

.stash-place--tight {
    margin-right: 4px;
}

.stash-label {
    font-size: 11px;
    margin-top: 10px;
}

.stash-pack {
    margin-top: 4px;
}

.stash-note {
    font-size: 12px;
    white-space: normal;
    margin-top: 8px;
}

/* ================================================================ Mejoras (UpgradesScreen) */

/* Mejoras (cuadro 164): its groups as columns side by side, as wide as they need. */
.upgrades {
    width: auto;
}

.upgrades__cols {
    flex-direction: row;
    align-items: flex-start;
}

.upgrades__col {
    width: 370px;
    margin-right: 24px;
}

.upgrades__col:last-child {
    margin-right: 0;
}

.upgrades__group {
    margin: 4px 0 2px;
    font-size: 13px;
    letter-spacing: 2px;
    color: #a1a79d;
}

.upgrade {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.upgrade__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.upgrade__name {
    font-size: 17px;
}

/* What the next level does, in figures (U3, cuadro 157); the sentence on hover. */
.upgrade__delta {
    font-size: 14px;
    white-space: normal;
    color: var(--t-text);
}

/* The level in words after the marks (B12). */
.upgrade__level {
    margin-left: 6px;
    font-size: 11px;
    color: #c4c9c0;
}

.upgrade__marks {
    flex-direction: row;
    margin-top: 4px;
}

.upgrade__mark {
    width: 18px;
    height: 4px;
    margin-right: 3px;
    background-color: rgba(255, 255, 255, 0.14);
}

.upgrade__mark--on {
    background-color: #8fd05a;
}

/* Its own width, whatever the sentence (cuadro 164: a long one shrank it, and the key, put to the right, covered the gap). */
.upgrade__side {
    flex-shrink: 0;
    align-items: flex-end;
    margin-left: 12px;
}

/* The price on the key (U3): after its word, in the key's ink. */
.upgrade__price {
    margin-left: 10px;
    margin-bottom: 0;
}

.upgrade__button-text,
.upgrade__button .supplies-mark__value {
    color: #15181a;
}

.upgrade__button-text {
    font-size: 13px;
}

.upgrade__button:disabled .upgrade__button-text,
.upgrade__button:disabled .supplies-mark__value {
    color: #6f756c;
}

.upgrade__button {
    flex-direction: row;
    align-items: center;
    height: 30px;
    margin: 0;
    padding: 0 12px;
    font-size: 13px;
    color: #15181a;
    background-color: #ecebe6;
    border-width: 0;
    border-radius: 0;
}

.upgrade__button:hover {
    background-color: #ffffff;
}

.upgrade__button:disabled {
    color: #6f756c;
    background-color: #2b2f31;
}

/* ================================================================ supplies (SuppliesMark): the figure and Arte's crate */

.supplies-mark {
    flex-direction: row;
    align-items: center;
}

.supplies-mark__pic {
    width: 26px;
    height: 26px;
    margin-left: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.supplies-mark--small .supplies-mark__pic {
    width: 20px;
    height: 20px;
    margin-left: 3px;
}

/* Between stages (U10, cuadro 56): Soldados' key to the board under the chosen one's name, its points under it. */
.kit-board {
    flex-direction: column;
    align-items: flex-start;
    margin-top: 6px;
    margin-bottom: 4px;
}

.kit-board .skill-foot__points {
    margin-left: 0;
    padding-left: 0;
    margin-top: 4px;
}
