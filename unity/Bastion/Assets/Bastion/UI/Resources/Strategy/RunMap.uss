/*
 * The map of an expedition (RunMapScreen) as a map drawn on paper (cuadros 126–132, P1: the light paper, Arte's valley):
 * the game's dark ground around it, the heading and «Volver a la base» over the sheet, the legend on the same paper under
 * it; on the right the squad folded to its busts (KitPanel, Stash.uss) over the stage's card in parts. The ways, the rings
 * and the pin are drawn in C# (DrawInk); the words are labels on a halo of paper.
 */

/* Over the whole screen, under the top strip and down where the base's tabs are (hidden on the map): no band of the
   clearing above nor below (cuadro 135). */
.runmap {
    position: absolute;
    left: 0;
    top: -49px;
    right: 0;
    bottom: -48px;
    background-color: #111416;
}

/* The map's side: from the left edge to the column on the right. */
.runmap-plate {
    position: absolute;
    left: 16px;
    top: 59px;
    bottom: 12px;
    right: 368px;
}

.runmap-top {
    margin-bottom: 8px;
}

/* Under the legend: «Volver a la base» and where one goes back from. */
.runmap-foot {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.runmap-head {
    font-size: 22px;
}

.runmap-line {
    font-size: 13px;
}

.runmap-back {
    height: 30px;
    margin: 0;
    padding: 0 14px;
    font-size: 13px;
    color: #eef0ea;
    background-color: #3d4346;
    border-width: 1px;
    border-color: #060708;
    border-radius: 0;
}

.runmap-back:hover {
    background-color: #4b5254;
}

.runmap-back:disabled {
    color: #6f756c;
}

/* Where the button went (G22, U21): where one goes back from, quiet. */
.runmap-home {
    margin: 0 0 0 12px;
    font-size: 12px;
}

/* ================================================================ the sheet */

.runmap-field {
    flex-grow: 1;
    overflow: hidden;
}

.runmap-sheet,
.runmap-valley,
.runmap-ink,
.runmap-marks {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* A stage: its ring's hit area, clear (the ring is the ink's); the place's symbol in it. */
.rnode {
    position: absolute;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-radius: 40px;
}

.rnode:hover,
.rnode:active {
    background-color: rgba(0, 0, 0, 0);
}

.rnode__q {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 17px;
    color: rgba(97, 84, 69, 0.85);
}

.runmap-symbol {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

/* A stage's words at its right: its name and its notes, each on a halo of paper (no line of the valley under a word). */
.runmap-words-at {
    position: absolute;
    align-items: flex-start;
}

.runmap-name {
    padding: 0 4px;
    font-size: 13px;
    white-space: nowrap;
    background-color: rgba(224, 214, 189, 0.9);
    border-radius: 3px;
}

.runmap-name--strong {
    -unity-font-style: bold;
}

.runmap-note {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    padding: 0 4px;
    background-color: rgba(224, 214, 189, 0.9);
    border-radius: 3px;
}

.runmap-note--end {
    margin-top: 1px;
    padding: 0 4px;
    font-size: 11px;
    color: #7a140d;
    background-color: rgba(224, 214, 189, 0.9);
    border-radius: 3px;
}

.runmap-note__mark {
    width: 12px;
    height: 12px;
    margin-right: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

/* A warning's mark (no seat, whose proposal): a dot, its words in ink. */
.runmap-note__mark--dot {
    width: 8px;
    height: 8px;
    margin: 0 4px 0 2px;
    border-radius: 4px;
}

.runmap-note__text {
    font-size: 11px;
    white-space: nowrap;
}

/* ================================================================ the legend, under the sheet */

.runmap-legend {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
    padding: 5px 12px;
    background-color: #e0d6bd;
}

.runmap-legend__head {
    margin-right: 14px;
    font-size: 11px;
    letter-spacing: 1.5px;
    color: #261f17;
}

.runmap-legend__mark {
    width: 13px;
    height: 13px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.runmap-legend__way {
    width: 30px;
    height: 10px;
    margin-right: 5px;
}

.runmap-legend__text {
    margin-right: 14px;
    font-size: 11px;
    color: #261f17;
}

/* ================================================================ the right: the squad folded, the stage's card */

.runmap-side {
    position: absolute;
    right: 18px;
    top: 12px;
    bottom: 10px;
    width: 334px;
}

.runmap-squad {
    padding: 10px 12px 10px;
    margin-bottom: 10px;
}

.runmap-card {
    padding: 12px 14px 14px;
}

.rcard__kicker {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: #a1a79d;
}

.rcard__top {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.rcard__icon {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    -unity-background-image-tint-color: #eef0ea;
}

.rcard__icon-sprite {
    width: 30px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
}

.rcard__name {
    font-size: 22px;
    white-space: normal;
    flex-shrink: 1;
}

.rcard__chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.rcard__chip {
    margin: 0 6px 4px 0;
    padding: 2px 7px;
    font-size: 11px;
    color: #ffffff;
    background-color: #2a3550;
}

.rcard__chip--danger1 {
    background-color: #5e7a4f;
}

.rcard__chip--danger2 {
    background-color: #b9822f;
}

.rcard__chip--danger3 {
    background-color: #b3261e;
}

.rcard__chip--storm {
    background-color: #46505a;
}

.rcard__chip--awake {
    background-color: #8a2a20;
}

.rcard__head {
    margin: 10px 0 2px;
    font-size: 11px;
    letter-spacing: 1.2px;
    color: #a1a79d;
}

.rcard__body {
    font-size: 13px;
    white-space: normal;
}

.rcard__note {
    margin-top: 6px;
}

.rcard__where {
    flex-direction: row;
    align-items: flex-start;
}

.rcard__place-icon {
    width: 38px;
    height: 38px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-image-tint-color: #eef0ea;
}

.rcard__place-words {
    flex-shrink: 1;
}

.rcard__place {
    font-size: 14px;
}

/* «Sin plaza libre», why not now: amber, as the stage card's warnings, not the danger's red. */
.rcard__warn {
    margin-top: 10px;
    padding: 6px 8px;
    font-size: 13px;
    white-space: normal;
    color: #f2c773;
    background-color: rgba(242, 199, 115, 0.1);
    border-left-width: 3px;
    border-left-color: #f2c773;
}

/* Whose proposal it is (two players): a bar in their colour. */
.rcard__whose {
    margin-top: 10px;
    padding: 2px 8px;
    font-size: 13px;
    border-left-width: 4px;
}

.rcard__hint {
    margin-top: 6px;
    color: #c4c9c0;
}

.rcard__go {
    margin: 14px 0 0 0;
    height: 34px;
    font-size: 14px;
}

/* ================================================================ a stop, over the map */

.runmap-field--under {
    opacity: 0.4;
}

/* Solid, so that the map under it doesn't show through. */
.runstop {
    position: absolute;
    left: 110px;
    top: 120px;
    width: 560px;
    padding: 16px 20px 16px 20px;
    background-color: #1a1d1f;
    border-width: 1px;
    border-color: #3d4346;
}

.runstop__kicker {
    font-size: 13px;
    color: #a1a79d;
}

.runstop__title {
    font-size: 24px;
    margin-bottom: 6px;
}

.runstop__text {
    font-size: 15px;
    white-space: normal;
    margin-bottom: 8px;
}

.runstop__line {
    font-size: 14px;
    white-space: normal;
    color: #c4c9c0;
}

.runstop__purse {
    margin: 4px 0 8px 0;
}

.runstop__purse-text {
    font-size: 16px;
}

.runstop__for {
    font-size: 13px;
}

.runstop__wares {
    margin-bottom: 6px;
}

.runstop__ware {
    flex-direction: row;
    align-items: center;
    height: 50px;
    margin-bottom: 4px;
    padding: 0 6px;
    background-color: rgba(0, 0, 0, 0.25);
}

.runstop__tile {
    width: 84px;
    height: 42px;
    justify-content: center;
    align-items: center;
    background-color: rgba(61, 67, 70, 0.55);
    margin-right: 10px;
}

.runstop__icon {
    width: 30px;
    height: 30px;
    -unity-background-image-tint-color: #dfe2da;
    -unity-background-scale-mode: scale-to-fit;
}

/* Arte's picture of the ware, its long side across the tile (a rifle reads small but whole). */
.runstop__art {
    width: 80px;
    height: 38px;
    -unity-background-scale-mode: scale-to-fit;
}

.runstop__glyph {
    font-size: 24px;
    color: #e2d6b4;
}

.runstop__ware-words {
    flex-grow: 1;
    justify-content: center;
}

.runstop__ware-name {
    font-size: 15px;
}

/* Why it can't be had now (B18), amber and small under its name, as «Sin plaza libre» on the map. */
.runstop__ware-why {
    margin-top: 1px;
    font-size: 12px;
    color: rgb(242, 199, 115);
}

.runstop__price {
    width: 80px;
    justify-content: flex-end;
    margin-right: 12px;
}

.runstop__purse-line {
    flex-direction: row;
    align-items: center;
}

.runstop__purse-amount {
    margin: 0 6px;
}

/* A stop right after the crate. */
.runstop__purse-amount--end {
    margin-right: 1px;
}

.runstop__buy,
.runstop__leave {
    height: 32px;
    margin: 0;
    padding: 0 14px;
    font-size: 14px;
    color: #15181a;
    background-color: #ecebe6;
    border-width: 0;
    border-radius: 0;
}

.runstop__buy:hover,
.runstop__leave:hover {
    background-color: #ffffff;
}

.runstop__buy:disabled,
.runstop__leave:disabled {
    color: #6f756c;
    background-color: #2b2f31;
}

.runstop__options {
    margin: 6px 0;
}

.runstop__option {
    margin: 0 0 6px 0;
    padding: 8px 12px;
    align-items: flex-start;
    background-color: #2b2f31;
    border-width: 1px;
    border-color: #4b5254;
    border-radius: 0;
}

.runstop__option:hover {
    background-color: #3d4346;
    border-color: #ffffff;
}

.runstop__option-label {
    font-size: 16px;
}

.runstop__option-short {
    font-size: 13px;
    color: #c4c9c0;
    white-space: normal;
}

.runstop__vote {
    font-size: 13px;
    margin-bottom: 6px;
}

.runstop__outcome {
    font-size: 15px;
    white-space: normal;
    padding: 8px 12px;
    margin: 6px 0;
    background-color: rgba(143, 208, 90, 0.12);
    border-left-width: 3px;
    border-color: #8fd05a;
}

.runstop__foot {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

/* A Refugio's way home (G22, U21), after «Seguir la expedición»: the map's old button's look, quieter than it. */
.runstop__home {
    height: 32px;
    margin: 0 0 0 8px;
    padding: 0 14px;
    font-size: 14px;
    color: #eef0ea;
    background-color: #3d4346;
    border-width: 1px;
    border-color: #060708;
    border-radius: 0;
}

.runstop__home:hover {
    background-color: #4b5254;
}

.runstop__home:disabled {
    color: #6f756c;
}

/* Asked to go on, the partner awaited: pressed again, taken back. */
.runstop__leave--on {
    background-color: #8fd05a;
}

.runstop__waiting {
    font-size: 13px;
    margin-left: 12px;
}
