/*
   The Armería (screen.ts renderEngineering, arms.ts, with strategy.css and mixta-base.css): the tabs and lists on the
   left, the detail on the right with its silhouette in the corner.
*/

/* A right panel as tall as what it holds, not the whole height (the item's card is short). */
.strat-side--fit {
    bottom: auto;
    max-height: 96%;
}

.armory-left {
    max-height: 98%;
}

.armory-tabs {
    flex-direction: row;
    margin-bottom: 6px;
    padding: 2px;
}

.armory-tab {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    height: 27px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
}

.armory-tab__label {
    font-size: 14px;
    letter-spacing: 1.5px;
    color: var(--t-muted);
}

.armory-tab--on {
    background-color: rgba(255, 255, 255, 0.04);
    border-bottom-width: 2px;
    border-bottom-color: var(--t-accent);
}

.armory-tab--on .armory-tab__label {
    color: #ffffff;
}

.armory-section {
    margin: 6px 0 2px;
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--t-muted);
}

.armory-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin: 0;
    padding: 1px 8px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0 0 1px 0;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    border-radius: 0;
}

.armory-row:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

/* The picked row: an amber bar on its left over a warm wash (mixta-base.css .x-row.on). */
.armory-row--on {
    background-color: rgba(242, 194, 48, 0.07);
    border-left-width: 3px;
    border-left-color: var(--t-accent);
}

.armory-row--dim {
    opacity: 0.5;
}

.armory-row__icon {
    width: 32px;
    height: 20px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #e7b84a;
}

.armory-row__tier {
    width: 32px;
    margin-right: 10px;
    justify-content: center;
}

.armory-row__tier-mark--1 {
    color: #ffffff;
}

.armory-row__tier-mark--2 {
    color: #5aa9ec;
}

.armory-row__tier-mark--3 {
    color: #a678ff;
}

.armory-row__words {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: flex-start;
}

.armory-row__top {
    flex-direction: row;
    align-items: center;
}

.armory-row__name {
    font-size: 13px;
    color: #ffffff;
    -unity-text-align: middle-left;
}

.armory-row__tag {
    margin-left: 6px;
    padding: 0 4px;
    font-size: 10px;
    background-color: rgba(255, 255, 255, 0.08);
}

.armory-row__tag--good {
    color: #8fd05a;
}

.armory-row__tag--warn {
    color: #1e1706;
    background-color: #c79a2a;
}

.armory-row__price {
    margin-top: 2px;
}

.armory-row__end {
    align-items: flex-end;
}

.armory-row__place {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--t-muted);
}

.armory-row__holder,
.armory-row__right {
    font-size: 11px;
    color: var(--t-muted);
}

.armory-note {
    margin-top: 6px;
    font-size: 12px;
}

/* =============================================================== detail */

.armory-art {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 76px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #e7b84a;
}

.armory-detail__name {
    font-size: 30px;
    letter-spacing: 1px;
    color: #ffffff;
}

.armory-detail__text {
    margin-top: 2px;
    font-size: 13px;
    white-space: normal;
}

.armory-main {
    align-self: flex-start;
    margin-top: 10px;
    padding: 5px 16px;
    font-size: 15px;
    letter-spacing: 1px;
}

.strat-why--small {
    font-size: 12px;
}

.armory-figures {
    margin-top: 10px;
    padding: 8px 10px;
}

.armory-figure {
    flex-direction: row;
}

.armory-figure__key {
    width: 132px;
    font-size: 12px;
    color: var(--t-muted);
}

.armory-figure__value {
    font-size: 12px;
    color: #ffffff;
}

.armory-range__head {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.armory-range__label {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--t-muted);
}

.armory-range__name {
    margin-left: 8px;
    font-size: 14px;
    color: #ffffff;
}

.armory-range {
    flex-direction: row;
    margin-top: 4px;
}

.armory-range__col {
    flex-grow: 1;
    align-items: center;
}

.armory-range__value {
    font-size: 10px;
    color: #ffffff;
}

.armory-range__up,
.armory-range__down {
    width: 60%;
    height: 9px;
}

.armory-range__up {
    justify-content: flex-end;
}

.armory-range__bar {
    width: 100%;
    background-color: #8fd05a;
}

.armory-range__bar--bad {
    background-color: #ff6a55;
}

.armory-range__base {
    width: 100%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.2);
}

.armory-range__distance {
    font-size: 10px;
    color: var(--t-muted);
}

.armory-range__unit {
    align-self: flex-end;
    font-size: 10px;
    color: var(--t-muted);
}

.armory-range__line {
    margin-top: 2px;
    font-size: 11px;
    color: var(--t-muted);
    white-space: normal;
}

.armory-condition {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.armory-gauge {
    width: 120px;
    height: 6px;
    margin-right: 8px;
}

.armory-gauge__fill {
    height: 100%;
    background-color: #8fd05a;
}

.armory-gauge__fill--worn {
    background-color: #ff6a55;
}

.armory-condition__text {
    font-size: 12px;
}

.armory-mod {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4px;
}

.armory-mod__name {
    font-size: 13px;
    color: #ffffff;
}

.armory-mod__line {
    margin-left: 4px;
    font-size: 11px;
    color: var(--t-muted);
}

.armory-slot {
    margin-top: 6px;
    padding: 6px 8px;
}

.armory-slot__head {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--t-muted);
    margin-bottom: 2px;
}

.armory-small {
    align-self: flex-start;
    margin: 2px 0 2px 6px;
    padding: 2px 8px;
    font-size: 11px;
    letter-spacing: 0.5px;
}

.armory-slot .armory-small {
    margin-left: 0;
}

.armory-carrier {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.armory-carrier__words {
    flex-grow: 1;
    flex-shrink: 1;
}

.armory-carrier__top {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.armory-carrier__name {
    font-size: 13px;
    color: #ffffff;
}

.armory-carrier__note {
    margin-left: 4px;
    font-size: 11px;
    color: var(--t-muted);
}

.armory-carrier__diff {
    flex-direction: row;
    flex-wrap: wrap;
}

.armory-diff {
    margin-right: 6px;
    font-size: 11px;
}

.armory-diff--good {
    color: #8fd05a;
}

.armory-diff--bad {
    color: #ff6a55;
}
